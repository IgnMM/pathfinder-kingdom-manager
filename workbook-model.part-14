-2"},{"row":173,"column":26,"value":"0"},{"row":173,"column":27,"value":"0"},{"row":173,"column":28,"value":"0"},{"row":173,"column":29,"value":"0"},{"row":173,"column":30,"value":"0"},{"row":173,"column":31,"value":"2"},{"row":173,"column":32,"value":"2"},{"row":174,"column":15,"value":"Unaging"},{"row":174,"column":16,"value":"0"},{"row":174,"column":17,"value":"0"},{"row":174,"column":18,"value":"0"},{"row":174,"column":19,"value":"0"},{"row":174,"column":20,"value":"0"},{"row":174,"column":21,"value":"0"},{"row":174,"column":22,"value":"0"},{"row":174,"column":23,"value":"4"},{"row":174,"column":24,"value":"0"},{"row":174,"column":25,"value":"0"},{"row":174,"column":26,"value":"-3"},{"row":174,"column":27,"value":"0"},{"row":174,"column":28,"value":"0"},{"row":174,"column":29,"value":"0"},{"row":174,"column":30,"value":"0"},{"row":174,"column":31,"value":"0"},{"row":174,"column":32,"value":"0"},{"row":175,"column":15,"value":"Unholy Site"},{"row":175,"column":16,"value":"0"},{"row":175,"column":17,"value":"0"},{"row":175,"column":18,"value":"0"},{"row":175,"column":19,"value":"0"},{"row":175,"column":20,"value":"0"},{"row":175,"column":21,"value":"2"},{"row":175,"column":22,"value":"0"},{"row":175,"column":23,"value":"0"},{"row":175,"column":24,"value":"0"},{"row":175,"column":25,"value":"0"},{"row":175,"column":26,"value":"0"},{"row":175,"column":27,"value":"0"},{"row":175,"column":28,"value":"0"},{"row":175,"column":29,"value":"0"},{"row":175,"column":30,"value":"0"},{"row":175,"column":31,"value":"1"},{"row":175,"column":32,"value":"1"}]},{"name":"Instructions_(Draft)","nonemptyRows":50,"maxRow":59,"maxColumn":2,"formulaCount":0,"inputCount":50,"functions":{},"dependencies":{},"formulas":[],"inputs":[{"row":2,"column":2,"value":"Instructions"},{"row":3,"column":2,"value":"City Map Template"},{"row":4,"column":2,"value":"Use the dropdown boxes to specify building type, whether the borders are land/water or if there is a city wall or not."},{"row":5,"column":2,"value":"Each square is a drop-down, just specify the building type (you'll have to do this manually for 2 and 4-square buildings)."},{"row":6,"column":2,"value":"The shown District is the middle District of a 5 x 5 matrix of Districts. To expand/add further Districts, Unprotect the sheet, highlight all the cells and then Unhide. You can then re-hide those Districts you don't want."},{"row":8,"column":2,"value":"Rulers"},{"row":9,"column":2,"value":"Enter the Attribute scores and skill ranks for the appropriate skills (if that optional rule is being used) here."},{"row":10,"column":2,"value":"Overall"},{"row":11,"column":2,"value":"Press F9 to update any calculationsor generate a random Event.This has been enabled toensure modifications to the Overall sheet do not automatically generate a new randomevent each time."},{"row":12,"column":2,"value":"Only text in white boxes can be added, deleted or changed. Anything in grey boxes is calculated. The rest is done using drop-down menus."},{"row":13,"column":2,"value":"Random weather is generated depending on the season selected."},{"row":14,"column":2,"value":"Current Year is calculated from 4708 AR plus however long the Kingdom has been going. Use YY.MM to represent the current Year/Month in the Kingdom Age box, e.g. 12.5 = 12 years and 5 months."},{"row":15,"column":2,"value":"Select the character in each Leadership role from the dropdown menu for that role."},{"row":17,"column":2,"value":"Hidden Sheets"},{"row":18,"column":2,"value":"Some sheets are hidden so you'll need to Unhide them to see/modify their contents."},{"row":19,"column":2,"value":"This includes additional cities and army sheets."},{"row":20,"column":2,"value":"Armys (Hidden)"},{"row":21,"column":2,"value":"All these are currently hidden until required, later on in the Kingmaker campaign. I haven't made any modifications to these from the original workbook."},{"row":23,"column":2,"value":"Drop Downs (Hidden)"},{"row":24,"column":2,"value":"This contains all the different lists used throughout the workbook. If you need to modify lists or add new ones, put them in here."},{"row":26,"column":2,"value":"Weather Generator (Hidden)"},{"row":27,"column":2,"value":"A very basic weather generator, feel free to modify or improve upon it! May do myself one day…"},{"row":29,"column":2,"value":"Event Generator (Hidden)"},{"row":30,"column":2,"value":"New events can be added, just modify the current list or add to it and then update the formulae at the top of the sheet."},{"row":31,"column":2,"value":"There is a list of unused events at the bottom of the sheet."},{"row":32,"column":2,"value":"Buildings"},{"row":33,"column":2,"value":"To add buildings to the City Map sheets, Copy and Paste from the Buildings sheet into the appropriate City Map sheet. This is an entirely visual representation of the city and does not propogate information to the City sheet itself, which must be updated separately."},{"row":34,"column":2,"value":"Diplomatic Edicts"},{"row":35,"column":2,"value":"Enter the name, size (in hexes), and alignment of the target kingdom. Select the Relationship which most closely matches, and select the target kingdom's attitude towards your kingdom. The Kingdom DC to increase the level of your diplomatic relationship is displayed."},{"row":36,"column":2,"value":"City Maps"},{"row":37,"column":2,"value":"To create a new City Map sheet (only 2 are included in this sheet), Unhide the \"City Map Master\" sheet, and select \"Move or Copy\". In the dalog box, tick the box that says \"Make a copy\", and select the city sheet you want to put the new map sheet in front of. Click \"OK\". Then right-click on the new \"City Map Master (2)\" sheet and rename it."},{"row":39,"column":2,"value":"Trade Routes"},{"row":40,"column":2,"value":"Select the city and trade route type from the drop-down menus. If that settlement can have that type of trade route, it will tell you. Input the length of the trade route. Two different DC's are calculated: The first is completely by the rules in Ultimate Campaign, the second represents the spreadsheet author's belief of theintendedrules."},{"row":42,"column":2,"value":"Diplomacy"},{"row":43,"column":2,"value":"Enter a kingdom name, size and alignment. Select one relationship - how your kingdom and the other kingdom are linked through third-party kingdoms. Select the target Kingdom's current attitude."},{"row":44,"column":2,"value":"If the diplomatic level rises to Treaty, enter the target kingdom's starting Economy, and if the diplomatic level rises to Alliance, enter the target kingdom's starting Stability. The Diplomatic sheet currently assumes balanced diplomacy."},{"row":46,"column":2,"value":"Deities and Holy Sites"},{"row":47,"column":2,"value":"Each City sheet now has a section below the comments to enter shrines, temples and cathedrals dedicated to specific deities. These currently stack with those shown in the normal buildings section of the sheet. If you are using this rule, do not enter the number of shrines, temples or cathedrals in the building lists."},{"row":48,"column":2,"value":"Open Office Users"},{"row":49,"column":2,"value":"As of the current version, I have been unable to convince Open Office to correctly read Fractional CR values. Please input them as decimals (1/8 = 0.125, 1/6 = 0.167 1/4 = 0.25, 1/3 = 0.333, and 1/2 = 0.5) in the Army sheets."},{"row":50,"column":2,"value":"Population Density"},{"row":51,"column":2,"value":"The Kingdom sheet has a cell for entering the Population Density of your kingdom (default 250). This figure affects the population per lot in settlements and per hex in the kingdom as a whole."},{"row":52,"column":2,"value":"Rank and Honorifics"},{"row":53,"column":2,"value":"Ultimate Rulership introduces a large number of real-world ranks (titles) and honorifics. To allow these to be used appropriately in this sheet, the Rulers tab now has a Gender column - all rulers should have their gender entered in here. Selecting an appropriate rank from the Rank column's dropdown list will generate an appropriate honorific for the character. Some of the ranks are listed twice - if the honorific shows an error, select the other version of the rank, as this indicates a mismatch between the gender of the character and the rank chosen. By default the ranks have Male versions listed before Female versions. It is also possible to create your own ranks and honorifics using the \"Custom Rank\" and \"Custom Honorific\" columns - these will override anything selected in the pre-defined columns when viewed on the Overall tab."},{"row":54,"column":2,"value":"Kingdom Terrain and Improvements"},{"row":55,"column":2,"value":"The Kingdom sheet contains two sets of information about the hexes in the kingdom. The single-column details modify the Kingdom Statistics, based on the contents of the hex. The larger matrix is used for calculating the hex populations - if there is a mismatch between the improvements listed on the single-column and the matrix, the total at the bottom of the matrix column will turn red. To ensure that the kingdom statistics and population are correctly calculated, the single-column and matrix both need to be completed."},{"row":56,"column":2,"value":"The ability to customise your hex base population levels is also included - hexes with rivers or coast will automatically have double the population entered, and hexes with rivers and coast will have triple the population entered. The default base population levels are those from Ultimate Rulership."},{"row":57,"column":2,"value":"Recruitment"},{"row":58,"column":2,"value":"Recruitment Edicts from Ultimate Rulership have their own tab (currently a first draft), which shows the maximum recruited military size, the maximum number of elite soldiers, the currently recruited army size and allows user input on the number of recruited militia. If the size of the army plus militia exceeds the Manpower number, a Loyalty penalty applies to the kingdom."},{"row":59,"column":2,"value":"Not yet implemented: Modifications to settlement/fort/watchtower defense andsettlement society from recruitment edicts."}]},{"name":"Credits_and_Version","nonemptyRows":367,"maxRow":375,"maxColumn":3,"formulaCount":0,"inputCount":418,"functions":{},"dependencies":{},"formulas":[],"inputs":[{"row":2,"column":2,"value":"Credits"},{"row":3,"column":2,"value":"Modifications of the original spreadsheet created byBerhagen.All credit to him for the initial design work!"},{"row":5,"column":2,"value":"Incorporates events, modifications and suggestions by various people on the Paizo Messageboard, too numerous to list (you know who you are!)."},{"row":7,"column":2,"value":"Draws upon information found in theBook of the River NationsfromJohn BrazerEnterprises. Purchase it from RPGNow.com today!"},{"row":9,"column":2,"value":"IMPORTANT NOTICE: Paizo Publishing, LLC Community Use Policy"},{"row":10,"column":2,"value":"This spreadsheet uses trademarks and/or copyrights owned by Paizo Publishing, LLC, which are used under Paizo's Community Use Policy."},{"row":11,"column":2,"value":"We are expressly prohibited from charging you to use or access this content."},{"row":12,"column":2,"value":"This spreadsheet is not published, endorsed, or specifically approved by Paizo Publishing."},{"row":13,"column":2,"value":"For more information about Paizo's Community Use Policy, please visit paizo.com/communityuse."},{"row":14,"column":2,"value":"For more information about Paizo Publishing and Paizo products, please visit paizo.com."},{"row":16,"column":2,"value":"IMPORTANT NOTICE FROM CHEMLAK: Version 5 and the Paizo Publishing, LLC Community Use Policy"},{"row":17,"column":2,"value":"Under the terms of the Community Use Policy, this spreadsheet is registered by Chemlak in the Paizo Publishing, LLC Community Use Register."},{"row":18,"column":2,"value":"Any person who subsequently creates an updated version of this sheet for community use and/or distribution MUST register their version separately and distinctly from any version registered by Chemlak."},{"row":19,"column":2,"value":"Chemlak is unable to transfer this registry without the express consent of Paizo Publishing, LLC, and failure to correctly register a new version may result in permission to host this sheet being withdrawn by Paizo Publishing, LLC."},{"row":21,"column":2,"value":"Version 1.0"},{"row":22,"column":2,"value":"Original Version"},{"row":23,"column":2,"value":"Version 1.1"},{"row":24,"column":2,"value":"Corrections:"},{"row":25,"column":2,"value":"Special Resources added to the Kingdom Sheet"},{"row":26,"column":2,"value":"Consumption calculation for cities corrected"},{"row":27,"column":2,"value":"Starting City Base Value included in Base Value calculation. Max Base Value set at 16000"},{"row":28,"column":2,"value":"Corrected Miscellaneous minor spelling and formatting errors"},{"row":29,"column":2,"value":"Upgrades:"},{"row":30,"column":2,"value":"\"Pop-Up\" Information implemented throughout the document\"Pop-Up\" Informationimplemented throughout the document"},{"row":31,"column":2,"value":"Multiple District City function incorporated"},{"row":32,"column":2,"value":"Vacancy calculation updated to base vacancies on empty \"Name\" fields"},{"row":33,"column":2,"value":"Version 1.2"},{"row":34,"column":2,"value":"Corrections:"},{"row":35,"column":2,"value":"Errata regarding Barracks, Exotic Craftsman, Gravyard, Watchtower implemented"},{"row":36,"column":2,"value":"Version 1.3"},{"row":37,"column":2,"value":"Corrections:"},{"row":38,"column":2,"value":"Updated calculations as not to count walls for population."},{"row":39,"column":2,"value":"Upgrades:"},{"row":40,"column":2,"value":"Added cells for magic items, reformatted city sheets to accommodate changes"},{"row":41,"column":2,"value":"Version 1.4"},{"row":42,"column":2,"value":"Corrections:"},{"row":43,"column":2,"value":"Updated calculations to base unrest calculation on empty name fields"},{"row":44,"column":2,"value":"Version 1.5"},{"row":45,"column":2,"value":"Corrections:"},{"row":46,"column":2,"value":"Corrections to the city overview sheet"},{"row":47,"column":2,"value":"Version 2.0"},{"row":48,"column":2,"value":"Corrections:"},{"row":49,"column":2,"value":"Correction to taxation calculation"},{"row":50,"column":2,"value":"Upgrades:"},{"row":51,"column":2,"value":"Added sheets and rules for armies"},{"row":53,"column":2,"value":"Version 3.0 - Zoetrope's Mods"},{"row":54,"column":2,"value":"Upgrades:"},{"row":55,"column":2,"value":"Added Event Generator and Random Events to Overall page"},{"row":56,"column":2,"value":"Added improvement calculator based on size to Overall page"},{"row":57,"column":2,"value":"Added Year Calculator, Calendar, Days of the Week, Basic Weather Generator ro Overall page"},{"row":58,"column":2,"value":"Added simple City Maps for each city"},{"row":59,"column":2,"value":"Addedd Defence calculation to the Overall page"},{"row":60,"column":2,"value":"Formatting:"},{"row":61,"column":2,"value":"Added colour!"},{"row":62,"column":2,"value":"Conditional formatting added where appropriate"},{"row":63,"column":2,"value":"Modifications:"},{"row":64,"column":2,"value":"Modified the dropdowns for Alignment on Overall sheet"},{"row":65,"column":2,"value":"Minor changes to calculations (formatting)"},{"row":66,"column":2,"value":"Added Optional Resources to Kingdom page"},{"row":67,"column":2,"value":"Added Optional Buildings to city pages"},{"row":69,"column":2,"value":"Version 4.0 - Brad Turner's Mods (Ultimate Campaign Update)"},{"row":70,"column":2,"value":"Ultimate Campaign Changes:"},{"row":71,"column":2,"value":"Added the Consort Leadership Role"},{"row":72,"column":2,"value":"Added the Heir Leadership Role"},{"row":73,"column":2,"value":"Added and adjusted several Buildings"},{"row":74,"column":2,"value":"Added and adjusted several Terrain Improvements"},{"row":75,"column":2,"value":"Wardens who are Vacant now only reduce Loyalty by 2 instead of by 4"},{"row":76,"column":2,"value":"Generals now apply their Vacancy Penalty to Loyalty instead of Stability"},{"row":77,"column":2,"value":"A Grand Diplomat vacancy no longer prevents Promotion Edicts"},{"row":78,"column":2,"value":"Renamed Royal Assassin to Royal Enforcer"},{"row":79,"column":2,"value":"Renamed Festivals to Holidays"},{"row":80,"column":2,"value":"Added Income field to the Kingdom and Overall sheets for things like extra BP from mines"},{"row":81,"column":2,"value":"Adjusted the minimum and maximum settlement Base Values"},{"row":82,"column":2,"value":"Arenas no longer have an effect on Consumption penalties from Holidays"},{"row":83,"column":2,"value":"Updated list of Continuous Events (and renamed Ongoing Events to Continuous Events)"},{"row":84,"column":2,"value":"Updated the field descriptions for all Leadership Roles"},{"row":85,"column":2,"value":"Modifications:"},{"row":86,"column":2,"value":"Changed the \"Armies\" consumption box to \"Other\" and made it editable"},{"row":87,"column":2,"value":"Redid the way the \"Major Buildings\" list works on the City Summary worksheet"},{"row":88,"column":2,"value":"Tweaked the kingdom alignment fields to prevent invalid combinations"},{"row":89,"column":2,"value":"Tweaked attribute fields for Rulers and Spymasters"},{"row":90,"column":2,"value":"Tweaked the way a few formulas work, especially in regards to vacancies and edicts"},{"row":91,"column":2,"value":"Formatting:"},{"row":92,"column":2,"value":"Fixed an error where the Rulers' Stability and Loyalty boxes had their colors backwards"},{"row":93,"column":2,"value":"Renamed \"Size\" to \"Population\" on city sheets"},{"row":94,"column":2,"value":"Changed colors slightly"},{"row":95,"column":2,"value":"Version 4.1"},{"row":96,"column":2,"value":"Ultimate Campaign Changes:"},{"row":97,"column":2,"value":"Added Magic Item slots and tracking to city sheets"},{"row":98,"column":2,"value":"Correction:"},{"row":99,"column":2,"value":"Fixed an error where Consumption would sometimes be calculated incorrectly"},{"row":99,"column":3,"value":"Credit and thanks to Netarious on the Paizo boards for catching this!"},{"row":100,"column":2,"value":"Formatting:"},{"row":101,"column":2,"value":"Renamed \"Defence\" to \"Defense\" on the Overall page… because I'm a selfish American…"},{"row":102,"column":2,"value":"Renamed \"Continuous Events\" on the Overall page to \"Current Events\""},{"row":103,"column":2,"value":"Version 4.1a (Bugfix)"},{"row":104,"column":2,"value":"Correction:"},{"row":105,"column":2,"value":"Fixed an pretty massive error in the math for city Consumption"},{"row":105,"column":3,"value":"Credit and thanks to Mordam, The Northerner on the Paizo boards for catching this!"},{"row":106,"column":2,"value":"Version 4.1b (Bugfix)"},{"row":107,"column":2,"value":"Ultimate Campaign Change/Correction:"},{"row":108,"column":2,"value":"The Control DC now adds the total number of districts in all your settlements to the DC"},{"row":108,"column":3,"value":"Credit and thanks to Dead Phoenix on the Paizo boards for catching this!"},{"row":109,"column":2,"value":"Version 4.2"},{"row":110,"column":2,"value":"Ultimate Campaign Change:"},{"row":111,"column":2,"value":"Added/Updated Army Tracking worksheets"},{"row":112,"column":2,"value":"Version 4.2a (Bugfix)"},{"row":112,"column":3,"value":"Credit and thanks to Kord Avatar on the Paizo boards for catching all of these!"},{"row":113,"column":2,"value":"Correction:"},{"row":114,"column":2,"value":"Fixed an error in the Consumption calculation of armies"},{"row":115,"column":2,"value":"Modifications:"},{"row":116,"column":2,"value":"Made the Morale field of armies editable by the user for easier adjustment"},{"row":117,"column":2,"value":"Formatting:"},{"row":118,"column":2,"value":"Made note of the army consumption being multiplied by 4 on the Overall sheet"},{"row":119,"column":2,"value":"Version 4.3 (Bugfix)"},{"row":119,"column":3,"value":"Temporary bugfix issue released by Chemlak on the Paizo boards, with thanks to Philip Knowsley, Deryen, Madbeard, Matt J Harris, hugozilla & Caraldur for jointly identifying issues and prompting me to update this sheet."},{"row":120,"column":2,"value":"Correction:"},{"row":121,"column":2,"value":"Graveyard bonus now modifies Loyalty correctly"},{"row":122,"column":2,"value":"Economy and Stability modifiers for multiple rivers and roads now counts each separately."},{"row":123,"column":2,"value":"Added Viceroy Kingdom role."},{"row":124,"column":2,"value":"Watchtower now adds +2 to Defence."},{"row":125,"column":2,"value":"Added \"connected to foundry\" modification to Mines."},{"row":126,"column":2,"value":"Version 4.3a (Bugfix)"},{"row":127,"column":2,"value":"Correction:"},{"row":128,"column":2,"value":"Corrected comment text for Viceroy and Heir (altered inappropriately in version 4.3)"},{"row":129,"column":2,"value":"Removed \"automatic Graveyard\" from City 2"},{"row":129,"column":3,"value":"Thanks to hugozila for noticing this pointing it out."},{"row":130,"column":2,"value":"Version 4.3b (Bugfix)"},{"row":131,"column":2,"value":"Correction:"},{"row":132,"column":2,"value":"Royal Enforcer's Unrest reduction was applying permanently to the Unrest Increment. It is an option, with possible consequences. Tooltip changed to include details."},{"row":132,"column":3,"value":"Thanks to Carl Cleroux on the Paizo forum for spotting this"},{"row":133,"column":2,"value":"Version 4.3c"},{"row":134,"column":2,"value":"Change:"},{"row":135,"column":2,"value":"Added Fame and Infamy trackers to Overall sheet and added Fame and Infamy information to all buildings. Starting Kingdoms should add 1 Fame or Infamy to the new (see below) \"Other (Permanent)\" column."},{"row":136,"column":2,"value":"Replaced \"Other\" with \"Other (Permanent)\" and added \"Other (Temporary)\" to Kingdom statistics on the Overall sheet - these should be used to separately track permanent and temporary modifiers, respectively."},{"row":137,"column":2,"value":"Version 4.3d (bugfix)"},{"row":138,"column":2,"value":"Change:"},{"row":139,"column":2,"value":"Corrected formulae to correctly calculate Stability and Population of cities."},{"row":139,"column":3,"value":"Thanks to Inner Heru on the Paizo forum for noticing this."},{"row":140,"column":2,"value":"Locked some unlocked cells on the Overall sheet."},{"row":141,"column":2,"value":"City Summary sheet now correctly displays Major Buildings for all City sheets."},{"row":142,"column":2,"value":"Version 4.4"},{"row":142,"column":3,"value":"Extra special thanks to Gelfar for helping me out with the hard work on this."},{"row":143,"column":2,"value":"Change:"},{"row":144,"column":2,"value":"SETTLEMENTS! Settlement statistics are now calculated for each settlement, settlement type is displayed in the City Summary, adjusted Fame and Infamy calculations to account for settlement stats."},{"row":145,"column":2,"value":"I am aware that the settlement modifier is displaying for settlements with zero population. This is to be fixed in an update at some point, but I really couldn't be bothered right now."},{"row":146,"column":2,"value":"Version 4.4a (bugfix)"},{"row":147,"column":2,"value":"Change:"},{"row":148,"column":2,"value":"An error had propogated in the Fame & Infamy calculations. This has been fixed."},{"row":148,"column":3,"value":"Thanks to Inner Heru on the Paizo forum for identifying this."},{"row":149,"column":2,"value":"Version 5 - Community Use Policy Required (see top of this page)"},{"row":150,"column":2,"value":"Change:"},{"row":151,"column":2,"value":"Added building images and City Map grids."},{"row":151,"column":3,"value":"kridak from the Paizo forums sent me (Chemlak) a sheet with some updates and it blew me away. So much so that I simply HAD to include the majority of the changes."},{"row":152,"column":2,"value":"More detailed tooltips for leadership roles on the Overall sheet."},{"row":153,"column":2,"value":"Turn sequence sheet added, detailing the steps to go through for a Kingdom turn."},{"row":154,"column":2,"value":"Events sheet added, with tables of kingdom events and detailed tooltips for the effects of the events."},{"row":155,"column":2,"value":"Charts sheet added, containing various tables used in the rules."},{"row":156,"column":2,"value":"Corrected resource consumption calculation for armies."},{"row":157,"column":2,"value":"Added Diplomatic Edicts on the new Diplomacy sheet."},{"row":158,"column":2,"value":"Version 5.0a (BugFix)"},{"row":159,"column":2,"value":"Change:"},{"row":160,"column":2,"value":"Put all 25 City sheets in the new format with annotations."},{"row":160,"column":3,"value":"Inner Heru on the Paizo forums noticed this one."},{"row":161,"column":2,"value":"Added instructions on adding new City Maps."},{"row":162,"column":2,"value":"Version 5.1 (Change, bugfix and update)"},{"row":163,"column":2,"value":"Change:"},{"row":164,"column":2,"value":"Corrected Army Consumption calculations for Resources."},{"row":165,"column":2,"value":"Added More Farm options (for farms in hexes containing or adjacent to Stockyards)"},{"row":166,"column":2,"value":"Trade Route sheet added. See Instructions for details."},{"row":167,"column":2,"value":"Added Rulers sheet. See Instructions for details."},{"row":168,"column":2,"value":"Renamed Buildings to Building Images. Added new Buildings sheet with all building details included for reference."},{"row":168,"column":3,"value":"Again, huge thanks to kridak from the Paizo forums for this addition."},{"row":169,"column":2,"value":"Added new Terrain Improvements sheet with terrain improvements details included for reference."},{"row":170,"column":2,"value":"Added City Map Master sheet (hidden) to be used as a template for other city maps. See Instructions for details."},{"row":171,"column":2,"value":"Version 5.1a (bugfix and update)"},{"row":172,"column":2,"value":"Change:"},{"row":173,"column":2,"value":"Removed lot size from Cistern - it can share a lot with other buildings."},{"row":174,"column":2,"value":"Added Menagerie CR entry box to all cities. Menagerie now calculates Loyalty bonus. Currently only accounts for one Menagerie. If multiple Menageries exist in the city, they will ALL provide the same loyalty bonus."},{"row":175,"column":2,"value":"Updated settlement statistics in all cities - if the settlement has no lots, the settlement statistics are all zero."},{"row":176,"column":2,"value":"Version 5.2 (bugfix and update)"},{"row":177,"column":2,"value":"Change:"},{"row":178,"column":2,"value":"Completed Diplomacy Edicts. Target Kingdom now has space for Starting Economy and Stability. See the Instructions sheet for details."},{"row":179,"column":2,"value":"Added Kingdom Forms of Government."},{"row":180,"column":2,"value":"Added Expanded Settlement Modifiers. All 25 city sheets will now use the greater of the kingdom's overall settlement statistics, or the settlement's own, whichever are higher."},{"row":181,"column":2,"value":"Bugfix:"},{"row":182,"column":2,"value":"Fixed Trade Route error which was returning incorrect details in some fields."},{"row":183,"column":2,"value":"Version 5.2a (bugfix)"},{"row":184,"column":2,"value":"Bugfix:"},{"row":185,"column":2,"value":"Corrected Improved Weapon army resources - they now correctly modify OM."},{"row":186,"column":2,"value":"Version 5.2b (bugfix)"},{"row":187,"column":2,"value":"Bugfix:"},{"row":188,"column":2,"value":"Added Law and Lore modifiers to the Monastery."},{"row":188,"column":3,"value":"Thanks to Kalnoch on the Paizo forums for spotting this one."},{"row":189,"column":2,"value":"Version 5.2c (update & bugfix)"},{"row":190,"column":2,"value":"Bugfix:"},{"row":191,"column":2,"value":"Corrected leadership role tooltips on Overall sheet - these now tell you what each role does, instead of just the Rulers."},{"row":192,"column":2,"value":"Bugfix:"},{"row":193,"column":2,"value":"Added Magic item details to Academy in the Buildings sheet. These had gone missing, but have been returned."},{"row":194,"column":2,"value":"Update:"},{"row":195,"column":2,"value":"Titles may now be given to your rulers! These have no effect, and are just there for handy notekeeping."},{"row":196,"column":2,"value":"Version 5.2d (update & bugfix)"},{"row":197,"column":2,"value":"Bugfix:"},{"row":198,"column":2,"value":"Corrected some more array references to make Open Office conversion easier."},{"row":199,"column":2,"value":"Bugfix:"},{"row":200,"column":2,"value":"Corrected cell references on Overall sheet so that Rulers are less likely to get lost."},{"row":201,"column":2,"value":"Update:"},{"row":202,"column":2,"value":"Deities and Holy Sites optional rule implemented. Please see the Instructions sheet for details."},{"row":203,"column":2,"value":"Update:"},{"row":204,"column":2,"value":"User-defined settlement modifiers. You can now manually add a modifier to each city's settlement statistics."},{"row":205,"column":2,"value":"Version 5.2e (update & bugfix)"},{"row":206,"column":2,"value":"Bugfix:"},{"row":207,"column":2,"value":"Corrected the Expanded Settlement Modifiers to correctly display integers on the Overall sheet."},{"row":208,"column":2,"value":"Update:"},{"row":209,"column":2,"value":"Added user-defined modifiers to the settlement statistics displayed on the Overall sheet."},{"row":210,"column":2,"value":"Version 5.2f (bugfix)"},{"row":211,"column":2,"value":"Bugfix:"},{"row":212,"column":2,"value":"Corrected cell pointers in hidden City Overview sheet. Various settlement modifiers should now be calculating correctly."},{"row":212,"column":3,"value":"Thanks to Kestrel.ca on the Paizo forums for identifying and pointing this out to me."},{"row":213,"column":2,"value":"Version 5.2g (bugfix)"},{"row":214,"column":2,"value":"Bugfix:"},{"row":215,"column":2,"value":"City Summary sheet was incorrectly displaying settlement sizes. This has now been fixed."},{"row":216,"column":2,"value":"Version 5.2h (update)"},{"row":217,"column":2,"value":"Update:"},{"row":218,"column":2,"value":"Settlement size modifiers optional rule implemented across all 25 city sheets."},{"row":219,"column":2,"value":"Version 5.2i (bugfix & update)"},{"row":220,"column":2,"value":"Bugfix:"},{"row":221,"column":2,"value":"Fixed loyalty incorrectly calculating in settlements."},{"row":221,"column":3,"value":"Thanks again to Inner Heru on the Paizo forums for spotting this one."},{"row":222,"column":2,"value":"Corrected tooltip for Sawmill w/ Resource, which was incorrectly displaying the effects. The calculation was correct, just the tooltip was wrong."},{"row":222,"column":3,"value":"Thanks to Philip Knowsley on the Paizo forums for noticing this."},{"row":223,"column":2,"value":"Update:"},{"row":224,"column":2,"value":"Added Feudal Monarchy as Government Type, with no modifiers to any statistics"},{"row":224,"column":3,"value":"Suggestion made by Philip Knowsley on the Paizo forums."},{"row":225,"column":2,"value":"Version 5.2j (bugfix)"},{"row":226,"column":2,"value":"Bugfix:"},{"row":227,"column":2,"value":"It seems that the priests all forgot how to create magic items if their temple was aligned, and they were also killing off their parishioners. Deities and Holy Sites optional rule corrected to add to population and add magic items to the settlement."},{"row":227,"column":3,"value":"Thanks to Jason the Half-GM from the Paizo forums for pointing me in the direction of a big oversight on my part with this rule."},{"row":228,"column":2,"value":"Version 5.3 (update)"},{"row":229,"column":2,"value":"Update:"},{"row":230,"column":2,"value":"The Grand Rebuild. All 25 City sheets now refer to the Buildings sheet when calculating Kingdom and Settlement modifiers from buildings (Special Case: The Deities and Holy Sites Optional rule at the bottom of each City sheet is pulling its own information from elsewhere for Kingdom modifiers). This is to facilitate and simplify adding new buildings to the sheet."},{"row":230,"column":3,"value":"Huge thanks to my good friend Gelfar, who sat with me and helped me crunch some of the more complex Excel formulae, and without whom this sheet would not be what it is today."},{"row":231,"column":2,"value":"Version 5.3a (bugfix)"},{"row":232,"column":2,"value":"Bugfix:"},{"row":233,"column":2,"value":"Corrected incorrect pointer for Leadership dropdown in Rulers sheet."},{"row":233,"column":3,"value":"Thanks to Jblues on the Paizo forums for pointing this one out."},{"row":234,"column":2,"value":"Known Issue:"},{"row":235,"column":2,"value":"Open Office does not seem to like fractional CR values being input in the Army sheets. Please use decimal values, as shown on the Instructions sheet."},{"row":236,"column":2,"value":"Version 5.3b (update)"},{"row":237,"column":2,"value":"Update:"},{"row":238,"column":2,"value":"User defined population density. The Kingdom sheet now has a cell in which users can define the population density of hexes and lots for their kingdom. Hexes and lots use the same density (default: 250)."},{"row":238,"column":3,"value":"This one's for Philip Knowsley on the Paizo forums. More precise control will come with Ultimate Rulership."},{"row":239,"column":2,"value":"Conditional formatting of the Ruler Kingdom Statistics has been adjusted: Cells will now only highlight in colour if a Kingdom Statistic is present in that cell."},{"row":239,"column":3,"value":"This has been bugging me for a while. Finally fixed it."},{"row":240,"column":2,"value":"Set a Print Area for the Overall sheet - if you wish to print out a single page, this should now work nicely for you."},{"row":241,"column":2,"value":"Adjusted some column widths in the Overall sheet, tidied up a few cell borders, and deleted some unnecessary columns. This sheet now looks a bit tidier."},{"row":242,"column":2,"value":"Added \"Kingdom Stats per BP\" columns to the Buildings sheet - these show the efficiency of the buildings in terms of their cost. Columns for Economy, Loyalty, Stability and Unrest are presented. Min-Max kingdom builders will want to get the lowest Unrest and the highest in the other three."},{"row":242,"column":3,"value":"This was suggested by Justabloke on the Paizo forums, and I thought it was a good idea. And I'm going to be building lots of dance halls, by the looks of things."},{"row":243,"column":2,"value":"Version 5.3c (bugfix)"},{"row":244,"column":2,"value":"Bugfix:"},{"row":245,"column":2,"value":"User defined population density. The Kingdom sheet now has a cell in which users can define the population density of hexes and lots for their kingdom. Hexes and lots use the same density (default: 250)."},{"row":246,"column":2,"value":"Version 5.3d (bugfix)"},{"row":247,"column":2,"value":"Bugfix:"},{"row":248,"column":2,"value":"The Guildhall is no longer an infinitely thin building, and now takes up the correct number of lots."},{"row":249,"column":2,"value":"Version 5.3e (bugfix)"},{"row":250,"column":2,"value":"Bugfix:"},{"row":251,"column":2,"value":"The Magic Shop and Market are now selling the correct kinds of items."},{"row":252,"column":2,"value":"Version 5.4 (Ultimate Rulership)"},{"row":252,"column":3,"value":"Special thanks go to Jason Nelson of Legendary Games for creating this expansion to the Ultimate Campaign Kingdom rules."},{"row":253,"column":2,"value":"Update:"},{"row":254,"column":2,"value":"New Buildings from Ultimate Rulership have been added to all cities and the Building tab."},{"row":255,"column":2,"value":"New Taxation, Holiday and Expansion (replacing Promotion) Edicts have been implemented on the Overall tab."},{"row":256,"column":2,"value":"Building Images for the new building types have been added to the Building Images tab (known issue: There is currently no Windmill image). These images are used with permission."},{"row":256,"column":3,"value":"Huge thanks to Jason Nelson of Legendary Games for allowing the use of Product Identity images in this spreadsheet."},{"row":257,"column":2,"value":"Added Titles from Ultimate Rulership, see Instructions sheet for details."},{"row":258,"column":2,"value":"Pending: Some of the Special features of the new building types have not yet been implemented."},{"row":259,"column":2,"value":"Version 5.4a (Ultimate Rulership)"},{"row":260,"column":2,"value":"Update:"},{"row":261,"column":2,"value":"Windmill added to the Building Images sheet."},{"row":261,"column":3,"value":"Massive thanks to Philip Knowsley from the Paizo forums for putting in the hard work I couldn't possibly hope to achieve in producing an excellent modification to the Alchemist's Lab which is now our Windmill."},{"row":262,"column":2,"value":"Bugfix:"},{"row":263,"column":2,"value":"The City Summary should now be displaying the correct buildings in the Major Buildings listings."},{"row":263,"column":3,"value":"Thanks to Marik Whiterose on the Paizo forums for identifying this one for me."},{"row":264,"column":2,"value":"Version 5.4b (Ultimate Rulership)"},{"row":265,"column":2,"value":"Update:"},{"row":266,"column":2,"value":"Population now calculating as per Ultimate Rulership for hexes and Cities."},{"row":267,"column":2,"value":"Settlement modifiers now calculating as per Ultimate Rulership."},{"row":268,"column":2,"value":"Settlement Sizes now calculating as per Ultimate Rulership."},{"row":269,"column":2,"value":"Settlement Base Values now calculating as per Ultimate Rulership."},{"row":270,"column":2,"value":"For hex populations, I have included the ability to alter the base population of a terrain type. See the Instructions sheet for details."},{"row":271,"column":2,"value":"Bugfix:"},{"row":272,"column":2,"value":"The previous bugfix to the City Summary Major Buildings details didn't work. Should now be fixed."},{"row":273,"column":2,"value":"Version 5.4c (Ultimate Rulership) Bugfix"},{"row":274,"column":2,"value":"Bugfix:"},{"row":275,"column":2,"value":"Corrected cell pointers on a large number of cells in the city sheets - your settlements should now have correct settlement statistics and magic items."},{"row":276,"column":2,"value":"Settlement modifiers are now correctly calculating for settlements of Metropolis size."},{"row":277,"column":2,"value":"The City Summary should no longer be showing incorrect major buildings and magic items. I promise. Pinky swear."},{"row":278,"column":2,"value":"Version 5.4d (Ultimate Rulership) Bugfix"},{"row":279,"column":2,"value":"Bugfix:"},{"row":280,"column":2,"value":"Corrected City Summary sheet (again). It will now be telling you the correct type of settlement."},{"row":281,"column":2,"value":"Version 5.4e (Ultimate Rulership) Bugfix & Update"},{"row":282,"column":2,"value":"Bugfix:"},{"row":283,"column":2,"value":"Corrected a number of cell pointers that could affect the Kingdom's overall Settlement Statistics, as well as prevent Trade edicts that should be possible."},{"row":284,"column":2,"value":"Update:"},{"row":285,"column":2,"value":"Adjusted consumption calculation on Overall sheet to display negative consumption. This is to help make tracking variable consumption figures easier."},{"row":286,"column":2,"value":"Version 5.4f (Ultimate Rulership) Bugfix & Update"},{"row":287,"column":2,"value":"Bugfix:"},{"row":288,"column":2,"value":"Corrected an issue with Expansion edicts modifiers to kingdom statistics."},{"row":288,"column":3,"value":"Thanks to Kryx on the Paizo forums for spotting this one."},{"row":289,"column":2,"value":"Update:"},{"row":290,"column":2,"value":"Added Fort with Lair and Watchtower with Lair to the Kingdom sheet."},{"row":290,"column":3,"value":"This one's Kryx's suggestion, however, see Known issues, below."},{"row":291,"column":2,"value":"Known Issue:"},{"row":292,"column":2,"value":"Defense is not a Kingdom-wide statistic - it applies only to Forts, Watchtowers, and Settlements within a particular hex."},{"row":293,"column":2,"value":"Version 5.4g (Ultimate Rulership) Bugfix"},{"row":294,"column":2,"value":"Bugfix:"},{"row":295,"column":2,"value":"Corrected Fame calculation"},{"row":295,"column":3,"value":"Thanks to Lethimer on the Paizo forums for spotting this long-standing bug."},{"row":296,"column":2,"value":"Version 5.4h (Ultimate Rulership) Update"},{"row":297,"column":2,"value":"Update:"},{"row":298,"column":2,"value":"A new dropdown exists on the Ruler sheet, allowing users to define which Leadership bonus rules they are using. The choices are Ultimate Campaign Core (Attributes only), Ultimate Campaign Optional (Attributes plus 1/5 ranks in certain skills), Ultimate Rulership Optional (2+1/3 ranks in those skills), and the Tarondor Variant Rule (Better of Ultimate Campaign Core and Ultimate Rulership Optional)."},{"row":298,"column":3,"value":"Thanks to Tarondor on the Paizo forums for posting about this. This one's for you."},{"row":299,"column":2,"value":"Version 5.4i (Ultimate Rulership) Bugfix"},{"row":300,"column":2,"value":"Bugfix:"},{"row":301,"column":2,"value":"Corrected some formulae on the Overall sheet that meant some Leader bonuses were calculating incorrectly in some cases."},{"row":301,"column":3,"value":"Thanks to Kord_Avatar on the Paizo forums for finding this one. Well spotted!"},{"row":302,"column":2,"value":"Version 5.4j (Ultimate Rulership) Update"},{"row":303,"column":2,"value":"Update:"},{"row":304,"column":2,"value":"As was quite rightly pointed out, the population matrix wasn't able to handle hexes with no terrain improvements. This has been corrected."},{"row":304,"column":3,"value":"Thanks again to Lethimer on the Paizo forums for pointing this issue out."},{"row":305,"column":2,"value":"Version 5.4k (Ultimate Rulership) Bugfix"},{"row":306,"column":2,"value":"Bugfix:"},{"row":307,"column":2,"value":"For some reason, the second ruler position wasn't looking in the right place. Fixed, now, and second rulers will start adding bonuses to the kingdom again."},{"row":307,"column":3,"value":"Thanks to T.A.U. on the Paizo forums for noticing this one."},{"row":308,"column":2,"value":"Version 5.4l (Ultimate Rulership) Update"},{"row":309,"column":2,"value":"Update:"},{"row":310,"column":2,"value":"Kingdom tab: Added effects of Brickyard and Lumberyard to terrain improvements.City tabs: It is now possible to select underlying terrain (split into two types, general terrain (for reference only), and water (which affects population)), natural advantages, and exotic settlement types to a settlement.Kingdom tab: Added effects of Brickyard and Lumberyard to terrain improvements.City tabs: It is now possible to select underlying terrain (split into two types, general terrain (for reference only), and water (which affects population)), natural advantages, and exotic settlement types to a settlement.Kingdom tab: Added effects of Brickyard and Lumberyard to terrain improvements.City tabs: It is now possible to select underlying terrain (split into two types, general terrain (for reference only), and water (which affects population)), natural advantages, and exotic settlement types to a settlement.Kingdom tab: Added effects of Brickyard and Lumberyard to terrain improvements.City tabs: It is now possible to select underlying terrain (split into two types, general terrain (for reference only), and water (which affects population)), natural advantages, and exotic settlement types to a settlement.Kingdom tab: Added effects of Brickyard and Lumberyard to terrain improvements.City tabs: It is now possible to select underlying terrain (split into two types, general terrain (for reference only), and water (which affects population)), natural advantages, and exotic settlement types to a settlement."},{"row":310,"column":3,"value":"Berhagen (you'll see his name right at the top of this page, and it's him we have to thank for EVERYTHING in this sheet) pointed out that the Lumberyard modification was missing from the Kingdom tab, I also spotted that the Brickyard was likewise missing."},{"row":311,"column":2,"value":"Version 5.4m (Ultimate Rulership) Update"},{"row":312,"column":2,"value":"Update:"},{"row":313,"column":2,"value":"Endowment tab: Endowment edicts may now be recorded on the Endowments tab. They will correctly affect kingdom statistics. There are not currently any error correction features in place to check that the buildings actually exist in the settlements in question."},{"row":314,"column":2,"value":"Version 5.4n (Ultimate Rulership) Bugfix & Update"},{"row":315,"column":2,"value":"Bugfix:"},{"row":316,"column":2,"value":"Terrain, natural advantages, and exotic settlement cells were locked (oops). Now unlocked, and drop-downs should work correctly."},{"row":316,"column":3,"value":"Thanks to Evil Midnight Lurker on the Paizo forums for pointing this one out."},{"row":317,"column":2,"value":"Update:"},{"row":318,"column":2,"value":"Added first draft of recruitment edicts. See Instructions sheet for details."},{"row":319,"column":2,"value":"Version 5.4o (Ultimate Rulership) Bugfix & Update"},{"row":320,"column":2,"value":"Bugfix:"},{"row":321,"column":2,"value":"Corrected an issue with consumption when multiple dice expressions from edicts were applicable at once."},{"row":321,"column":3,"value":"Thanks to Gabrial Goodfellow on the Paizo forums for noticing this one (obviously his party are very aggressive, but love a good party)."},{"row":322,"column":2,"value":"Update:"},{"row":323,"column":2,"value":"Sorting the buildings sheet should now work correctly."},{"row":323,"column":3,"value":"This is another one Gabrial Goodfellow pointed out."},{"row":324,"column":2,"value":"Known Issues:"},{"row":325,"column":2,"value":"Settlements of City size and larger aren't charging the correct consumption. This will be fixed in a future update."},{"row":325,"column":3,"value":"Thanks to Galleazo on the Paizo forums for flagging these important details. These will be corrected in a future update."},{"row":326,"column":2,"value":"Some buildings which increase Fame are not correctly increasing Fame."},{"row":327,"column":2,"value":"Version 5.4p (Ultimate Rulership) Bugfix"},{"row":328,"column":2,"value":"Bugfix:"},{"row":329,"column":2,"value":"Corrected Ultimate Rulership consumption rules - all buildings which add fame are correctly doing so, and also now add consumption, and consumption is now correct for settlements of different sizes."},{"row":329,"column":3,"value":"The long-awaited fix for the issues Galleazo identified."},{"row":330,"column":2,"value":"Version 5.4q (Ultimate Rulership) Bugfix"},{"row":331,"column":2,"value":"Bugfix:"},{"row":332,"column":2,"value":"Armies with ACR lower than 1 were not calculating ACR correctly."},{"row":332,"column":3,"value":"Thanks to Curghann on the Paizo forums for pointing me towards this one."},{"row":333,"column":2,"value":"Version 5.4r (Ultimate Rulership) Bugfix"},{"row":334,"column":2,"value":"Bugfix:"},{"row":335,"column":2,"value":"Corrected consumption for settlements containing Hanging Gardens."},{"row":336,"column":2,"value":"Added \"Total\" column to the Kingdom hex matrix, and re-calculated the formulae. The kingdom's population should now calculate correctly."},{"row":336,"column":3,"value":"Thanks to Galleazo on the Paizo forums for spotting these."},{"row":337,"column":2,"value":"Removed some extraneous data from a couple of the city sheets."},{"row":338,"column":2,"value":"Update (unworthy of full build number):"},{"row":339,"column":2,"value":"Added tooltip to Overall sheet and Kingdom sheet (Kingdom Name and Hexes input cells, respectively), to display the improvements edict table on mouseover. Similar charts will be forthcoming for the City sheets in the near future."},{"row":339,"column":3,"value":"As requested by... Lots of people, really."},{"row":340,"column":2,"value":"Version 5.5 (Ultimate Rulership) Update"},{"row":341,"column":2,"value":"Update:"},{"row":342,"column":2,"value":"Added Purchase Limit, Danger Level, and Spellcasting level to settlements."},{"row":343,"column":2,"value":"Added Magical Improvements and Settlement Attributes to settlements."},{"row":344,"column":2,"value":"Updated Events to Ultimate Rulership."},{"row":345,"column":2,"value":"To do:"},{"row":346,"column":2,"value":"Settlement Disadvantages."},{"row":347,"column":2,"value":"Annotations for Magical Improvements."},{"row":348,"column":2,"value":"Version 5.5a (Ultimate Rulership) Bugfix"},{"row":349,"column":2,"value":"Bugfix:"},{"row":350,"column":2,"value":"Named dropdowns, reformatted appropriate data validations. Sheet should now work in any spreadsheet program."},{"row":351,"column":2,"value":"Version 5.5b (Ultimate Rulership) Bugfix"},{"row":352,"column":2,"value":"Bugfix:"},{"row":353,"column":2,"value":"Named dropdowns, reformatted appropriate data validations. Sheet should now work in any spreadsheet program."},{"row":353,"column":3,"value":"Many thanks to redcelt32 on the Paizo forums for pointing me in the right direction for these."},{"row":354,"column":2,"value":"Version 5.5c (Ultimate Rulership) Bugfix"},{"row":355,"column":2,"value":"Bugfix:"},{"row":356,"column":2,"value":"Trade Routes were not using the Control DC as the base, and weren't using the correct results for Corruption and Productivity in the origin settlement."},{"row":356,"column":3,"value":"Thanks to Steven Evans on the Paizo forums for making me look at the first one, which led me to the second. Steven also gets a special mention for noticing a bug in 5.5a, which was fixed in 5.5b (apologies for the poorly written patch notes)."},{"row":357,"column":2,"value":"Version 5.5d (Ultimate Rulership) Bugfix"},{"row":358,"column":2,"value":"Bugfix:"},{"row":359,"column":2,"value":"All trade routes were using the same length modifier. This has now been corrected, and each trade route will use its own LM for calculating the DC."},{"row":360,"column":2,"value":"Version 5.6 (Ultimate Rulership) Update"},{"row":361,"column":2,"value":"Update:"},{"row":362,"column":2,"value":"Settlement attributes are implemented."},{"row":362,"column":3,"value":"I took some liberties when it comes to the number of attributes a settlement should have, but it's not enforced anywhere, so add as many as you want."},{"row":363,"column":2,"value":"Version 5.6a (Ultimate Rulership) Bugfix"},{"row":364,"column":2,"value":"Bugfix:"},{"row":365,"column":2,"value":"Knowedge (Engineering) has now been correctly spelt as Knowledge (Engineering), and Skill Focus in that skill will now correctly work for Wardens."},{"row":365,"column":3,"value":"Canadian Bakka on the Paizo forum gets my thanks for picking up on this one - how painful one little letter can be, and sorry for the delay in fixing it."},{"row":366,"column":2,"value":"Bugfix:"},{"row":367,"column":2,"value":"All settlements were displaying the kingdom's overall settlement attribute modifier if that modifier was 1 or higher. Settlements with no lots will now always display 0 for settlement attributes."},{"row":367,"column":3,"value":"Thanks to Heaven's Thunder Hammer on the Paizo forums for pointing this one out to me. Those formulae are even more monstrous now, but at least they do what they're meant to."},{"row":368,"column":2,"value":"Version 5.7 (Ultimate Rulership) Update"},{"row":369,"column":2,"value":"Update:"},{"row":370,"column":2,"value":"Festival Edicts! Your kingdom may now have up to 28 Festival edicts simultaneously in effect. An active festival edict will increase all appropriate kingdom and settlement statistics, as well as increase the base value of the settlement and add temporary magical item slots. A warning message appears in the city sheet if you have selected that settlement for one of your festival edicts."},{"row":370,"column":3,"value":"I can't for the life of me imagine why anyone would want to have 28 simultaneous festivals running. But someone might decide to."},{"row":371,"column":2,"value":"Version 5.7a (Ultimate Rulership) Bugfix"},{"row":372,"column":2,"value":"Bugfix:"},{"row":373,"column":2,"value":"Duplicated Settlement Attributes have now been eliminated. The more detailed set remain."},{"row":374,"column":2,"value":"Bugfix:"},{"row":375,"column":2,"value":"Trade Route Types have now been restored, and it is again possible to set up trade routes."},{"row":375,"column":3,"value":"Thanks to Tankuru on the Paizo forums for spotting this one."}]},{"name":"Military_Overview","nonemptyRows":13,"maxRow":15,"maxColumn":13,"formulaCount":22,"inputCount":16,"functions":{"VLOOKUP":11,"IF":9,"SUM":1},"dependencies":{"Drop_Down":11,"Overall":1,"Army_1":1,"Army_2":1,"Army_3":1,"Army_4":1,"Army_5":1,"Army_6":1,"Army_7":1,"Army_8":1,"Army_9":1},"formulas":[{"row":4,"column":9,"formula":"of:=[Overall.R64]","cached":"Normal"},{"row":4,"column":11,"formula":"of:=VLOOKUP([.I4];[Drop_Down.O107:.V111];6;0)","cached":"0"},{"row":4,"column":13,"formula":"of:=VLOOKUP([.I4];[Drop_Down.O107:.V111];8;0)","cached":"0"},{"row":5,"column":4,"formula":"of:=[Army_1.$F$4]","cached":"0"},{"row":5,"column":6,"formula":"of:=IF([.D5]<>0;VLOOKUP([.$D5];[Drop_Down.$C$30:.$E$39];3;0);0)","cached":"0"},{"row":6,"column":4,"formula":"of:=[Army_2.$F$4]","cached":"0"},{"row":6,"column":6,"formula":"of:=IF([.D6]<>0;VLOOKUP([.$D6];[Drop_Down.$C$30:.$E$39];3;0);0)","cached":"0"},{"row":7,"column":4,"formula":"of:=[Army_3.$F$4]","cached":"0"},{"row":7,"column":6,"formula":"of:=IF([.D7]<>0;VLOOKUP([.$D7];[Drop_Down.$C$30:.$E$39];3;0);0)","cached":"0"},{"row":8,"column":4,"formula":"of:=[Army_4.$F$4]","cached":"0"},{"row":8,"column":6,"formula":"of:=IF([.D8]<>0;VLOOKUP([.$D8];[Drop_Down.$C$30:.$E$39];3;0);0)","cached":"0"},{"row":9,"column":4,"formula":"of:=[Army_5.$F$4]","cached":"0"},{"row":9,"column":6,"formula":"of:=IF([.D9]<>0;VLOOKUP([.$D9];[Drop_Down.$C$30:.$E$39];3;0);0)","cached":"0"},{"row":10,"column":4,"formula":"of:=[Army_6.$F$4]","cached":"0"},{"row":10,"column":6,"formula":"of:=IF([.D10]<>0;VLOOKUP([.$D10];[Drop_Down.$C$30:.$E$39];3;0);0)","cached":"0"},{"row":11,"column":4,"formula":"of:=[Army_7.$F$4]","cached":"0"},{"row":11,"column":6,"formula":"of:=IF([.D11]<>0;VLOOKUP([.$D11];[Drop_Down.$C$30:.$E$39];3;0);0)","cached":"0"},{"row":12,"column":4,"formula":"of:=[Army_8.$F$4]","cached":"0"},{"row":12,"column":6,"formula":"of:=IF([.D12]<>0;VLOOKUP([.$D12];[Drop_Down.$C$30:.$E$39];3;0);0)","cached":"0"},{"row":13,"column":4,"formula":"of:=[Army_9.$F$4]","cached":"0"},{"row":13,"column":6,"formula":"of:=IF([.D13]<>0;VLOOKUP([.$D13];[Drop_Down.$C$30:.$E$39];3;0);0)","cached":"0"},{"row":15,"column":6,"formula":"of:=SUM([.F5:.F13])","cached":"0"}],"inputs":[{"row":2,"column":2,"value":"Number of troops"},{"row":2,"column":9,"value":"Militarism"},{"row":3,"column":11,"value":"Defense"},{"row":3,"column":13,"value":"Society"},{"row":4,"column":2,"value":"Army"},{"row":4,"column":4,"value":"Size"},{"row":4,"column":6,"value":"Troops"},{"row":5,"column":2,"value":"1"},{"row":6,"column":2,"value":"2"},{"row":7,"column":2,"value":"3"},{"row":8,"column":2,"value":"4"},{"row":9,"column":2,"value":"5"},{"row":10,"column":2,"value":"6"},{"row":11,"column":2,"value":"7"},{"row":12,"column":2,"value":"8"},{"row":13,"column":2,"value":"9"}]}],"totals":{"sheets":59,"formulas":52756,"functions":{"VLOOKUP":80859,"IF":56662,"SUM":3410,"INT":2273,"ROW":2000,"INDEX":1750,"SMALL":1000,"ROUNDDOWN":978,"ISERROR":875,"ISNA":775,"MATCH":750,"CONCATENATE":611,"ISBLANK":431,"KNOWLEDGE":416,"COUNTIF":268,"ABS":152,"PROFESSION":104,"SUMPRODUCT":90,"MIN":75,"ROUNDUP":25,"ATTRIBUTES":25,"COUNTA":25,"ARMOR":18,"WEAPONS":18,"BOND":9,"OR":2}}}