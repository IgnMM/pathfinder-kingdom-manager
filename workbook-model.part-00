umn":2,"value":"Corruption"},{"row":20,"column":5,"value":"="},{"row":20,"column":15,"value":"+"},{"row":20,"column":23,"value":"+"},{"row":20,"column":25,"value":"+"},{"row":20,"column":27,"value":"+"},{"row":22,"column":2,"value":"Crime"},{"row":22,"column":5,"value":"="},{"row":22,"column":15,"value":"+"},{"row":22,"column":23,"value":"+"},{"row":22,"column":25,"value":"+"},{"row":22,"column":27,"value":"+"},{"row":24,"column":2,"value":"Law"},{"row":24,"column":5,"value":"="},{"row":24,"column":15,"value":"+"},{"row":24,"column":23,"value":"+"},{"row":24,"column":25,"value":"+"},{"row":24,"column":27,"value":"+"},{"row":26,"column":2,"value":"Lore"},{"row":26,"column":5,"value":"="},{"row":26,"column":15,"value":"+"},{"row":26,"column":23,"value":"+"},{"row":26,"column":25,"value":"+"},{"row":26,"column":27,"value":"+"},{"row":28,"column":2,"value":"Productivity"},{"row":28,"column":5,"value":"="},{"row":28,"column":15,"value":"+"},{"row":28,"column":23,"value":"+"},{"row":28,"column":25,"value":"+"},{"row":28,"column":27,"value":"+"},{"row":30,"column":2,"value":"Society"},{"row":30,"column":5,"value":"="},{"row":30,"column":15,"value":"+"},{"row":30,"column":23,"value":"+"},{"row":30,"column":25,"value":"+"},{"row":30,"column":27,"value":"+"},{"row":32,"column":2,"value":"Leadership"},{"row":32,"column":20,"value":"Miscellaneous"},{"row":34,"column":2,"value":"Role"},{"row":34,"column":4,"value":"Rank"},{"row":34,"column":6,"value":"Honorific"},{"row":34,"column":8,"value":"Name"},{"row":34,"column":12,"value":"Bonus"},{"row":34,"column":14,"value":"Attribute"},{"row":34,"column":16,"value":"PRESS F9 TO CALCULATE/UPDATE"},{"row":34,"column":24,"value":"Current Events"},{"row":36,"column":2,"value":"Ruler"},{"row":36,"column":8,"value":"Benefit(s):Choose one kingdom attribute (Economy, Loyalty, or Stability). Add your Charisma modifier to this attribute.If your kingdom's Size is 26–100, choose a second kingdom attribute and add your Charisma modifier to it as well.If your kingdom's Size is 101 or more, choose a third kingdom attribute and add your Charisma modifier to it too.If you have theLeadershipfeat, the bonus from the feat applies to all kingdom attributes you affect (one, two, or three attributes, depending on the kingdom's Size).Vacancy Penalty:A kingdom without a ruler cannot claim new hexes, create Farms, build Roads, or purchase settlement districts. Unrest increases by 4 during the kingdom's Upkeep Phase.LEADERSHIP ROLE SKILLSFor every 5 full ranks in a relevant skill, the leader may increase the leadership modifier by an additional 1.Ruler: Knowledge (nobility)"},{"row":36,"column":20,"value":"Treasury"},{"row":38,"column":2,"value":"Ruler"},{"row":38,"column":20,"value":"Income"},{"row":40,"column":2,"value":"Consort"},{"row":40,"column":8,"value":"Benefit(s):Add half your Charisma modifier to Loyalty.If the ruler is unavailable during a turn, you may act as the Ruler for that turn, negating the vacancy penalty for having no Ruler, though you do not gain the Ruler benefit.If you act as the Ruler for the turn, you must succeed at a Loyalty check during the kingdom's Upkeep Phase or Unrest increases by 1.Vacancy Penalty:None.LEADERSHIP ROLE SKILLSFor every 5 full ranks in a relevant skill, the leader may increase the leadership modifier by an additional 1.Consort: Knowledge (nobility)"},{"row":40,"column":14,"value":"Loyalty"},{"row":40,"column":16,"value":"Unrest Increment"},{"row":40,"column":20,"value":"Defense"},{"row":42,"column":2,"value":"Councilor"},{"row":42,"column":8,"value":"Benefit(s):Add your Charisma modifier or Wisdom modifier to Loyalty.Vacancy Penalty:Loyalty decreases by 2. The kingdom gains no benefits from the Holiday edict. During the Upkeep Phase, Unrest increases by 1.LEADERSHIP ROLE SKILLSFor every 5 full ranks in a relevant skill, the leader may increase the leadership modifier by an additional 1.Councilor: Knowledge (local)"},{"row":42,"column":14,"value":"Loyalty"},{"row":42,"column":20,"value":"Unrest"},{"row":44,"column":2,"value":"General"},{"row":44,"column":8,"value":"Benefit(s):Add your Charisma modifier or Strength modifier to Stability.Vacancy Penalty:Loyalty decreases by 4.LEADERSHIP ROLE SKILLSFor every 5 full ranks in a relevant skill, the leader may increase the leadership modifier by an additional 1.General: Profession (soldier)"},{"row":44,"column":14,"value":"Stability"},{"row":44,"column":18,"value":"Revenue Divisor"},{"row":46,"column":2,"value":"Grand Diplomat"},{"row":46,"column":8,"value":"Benefit(s):Add your Charisma modifier or Intelligence modifier to Stability.Vacancy Penalty:Stability decreases by 2. The kingdom cannot issue Diplomatic or Exploration edicts.LEADERSHIP ROLE SKILLSFor every 5 full ranks in a relevant skill, the leader may increase the leadership modifier by an additional 1.Grand Diplomat: Diplomacy"},{"row":46,"column":14,"value":"Stability"},{"row":46,"column":16,"value":"Consumption"},{"row":48,"column":2,"value":"Heir"},{"row":48,"column":8,"value":"Benefit(s):Add half your Charisma modifier to Loyalty. You may act as the Ruler for a turn, negating the vacancy penalty for the kingdom having no Ruler, though you do not gain the Ruler benefit.Whenever you act as the Ruler for the turn, you must succeed at a Loyalty check during the kingdom's Upkeep Phase or Unrest increases by 1.Vacancy Penalty:None.LEADERSHIP ROLE SKILLSFor every 5 full ranks in a relevant skill, the leader may increase the leadership modifier by an additional 1.Heir: Knowledge (nobility)"},{"row":48,"column":14,"value":"Loyalty"},{"row":48,"column":16,"value":"Total"},{"row":48,"column":18,"value":"Size"},{"row":48,"column":20,"value":"Cities"},{"row":48,"column":22,"value":"Edicts"},{"row":48,"column":24,"value":"Terrain"},{"row":48,"column":26,"value":"Armies"},{"row":48,"column":28,"value":"Other"},{"row":50,"column":2,"value":"High Priest"},{"row":50,"column":8,"value":"Benefit(s):Add your Charisma modifier or Wisdom modifier to Stability.Vacancy Penalty:Stability and Loyalty decrease by 2. During the Upkeep Phase, Unrest increases by 1.LEADERSHIP ROLE SKILLSFor every 5 full ranks in a relevant skill, the leader may increase the leadership modifier by an additional 1.High Priest: Knowledge (religion)"},{"row":50,"column":14,"value":"Stability"},{"row":50,"column":17,"value":"="},{"row":50,"column":19,"value":"+"},{"row":50,"column":21,"value":"+"},{"row":50,"column":23,"value":"+"},{"row":50,"column":25,"value":"+"},{"row":50,"column":27,"value":"+"},{"row":52,"column":2,"value":"Magister"},{"row":52,"column":8,"value":"Benefit(s):Add your Charisma modifier or Intelligence modifier to Economy.Vacancy Penalty:Economy decreases by 4.LEADERSHIP ROLE SKILLSFor every 5 full ranks in a relevant skill, the leader may increase the leadership modifier by an additional 1.Magister: Knowledge (arcana)"},{"row":52,"column":14,"value":"Economy"},{"row":52,"column":16,"value":"Army consumption is paid weekly which is represented here by multiplying it by 4."},{"row":54,"column":2,"value":"Marshal"},{"row":54,"column":8,"value":"Benefit(s):Add your Dexterity modifier or Wisdom modifier to Economy.Vacancy Penalty:Economy decreases by 4.LEADERSHIP ROLE SKILLSFor every 5 full ranks in a relevant skill, the leader may increase the leadership modifier by an additional 1.Marshal: Survival"},{"row":54,"column":14,"value":"Economy"},{"row":54,"column":16,"value":"Edicts"},{"row":56,"column":2,"value":"Royal Enforcer"},{"row":56,"column":8,"value":"Benefit(s):Add your Dexterity modifier or Strength modifier to Loyalty. During the Upkeep Phase, you may decrease Unrest by 1 (this is not affected by having the Leadership feat); if you do so, you must succeed at a Loyalty check or Loyalty decreases by 1.Vacancy Penalty:None.LEADERSHIP ROLE SKILLSFor every 5 full ranks in a relevant skill, the leader may increase the leadership modifier by an additional 1.Royal Enforcer: Intimidate"},{"row":56,"column":14,"value":"Loyalty"},{"row":56,"column":18,"value":"Level"},{"row":56,"column":20,"value":"Stability"},{"row":56,"column":22,"value":"Economy"},{"row":56,"column":24,"value":"Loyalty"},{"row":56,"column":26,"value":"BP"},{"row":58,"column":2,"value":"Spymaster"},{"row":58,"column":8,"value":"Benefit(s):During the Edict Phase, choose one kingdom attribute (Economy, Loyalty or Stability).Add your Dexterity modifier or Intelligence modifier to this attribute.Vacancy Penalty:Economy decreases by 4. During the Upkeep Phase, Unrest increases by 1.LEADERSHIP ROLE SKILLSFor every 5 full ranks in a relevant skill, the leader may increase the leadership modifier by an additional 1.Spymaster: Sense Motive"},{"row":58,"column":16,"value":"Expansion"},{"row":58,"column":18,"value":"Standard"},{"row":60,"column":2,"value":"Treasurer"},{"row":60,"column":8,"value":"Benefit(s):Add your Intelligence modifier or Wisdom modifier to Economy.Vacancy Penalty:Economy decreases by 4. The kingdom cannot collect taxes—during the Edict Phase, when you would normally collect taxes, the kingdom does not collect taxes at all and the taxation level is considered \"none.\"LEADERSHIP ROLE SKILLSFor every 5 full ranks in a relevant skill, the leader may increase the leadership modifier by an additional 1.Treasurer: Profession (merchant)"},{"row":60,"column":14,"value":"Economy"},{"row":60,"column":16,"value":"Taxation"},{"row":60,"column":18,"value":"Normal"},{"row":62,"column":2,"value":"Viceroy"},{"row":62,"column":8,"value":"Benefit(s):Add half your Intelligence or Wisdom modifier to Economy.You may assume any leadership role (including Ruler) for your colony or vassal state, but any benefit you provide in this role is 1 less than normal; if you do so, you must spend 7 days that month performing duties appropriate to that leadership role in addition to the 7 days spent for Viceroy duties.Vacancy Penalty:If you have no Viceroy for your vassal state, treat it as if it had the Ruler vacancy penalty.LEADERSHIP ROLE SKILLSFor every 5 full ranks in a relevant skill, the leader may increase the leadership modifier by an additional 1.Viceroy: Knowledge (geography)"},{"row":62,"column":14,"value":"Economy"},{"row":62,"column":16,"value":"Holidays"},{"row":62,"column":18,"value":"None"},{"row":64,"column":2,"value":"Warden"},{"row":64,"column":8,"value":"Benefit(s):Add your Constitution modifier or Strength modifier to Loyalty.Vacancy Penalty:Loyalty and Stability decrease by 2.LEADERSHIP ROLE SKILLSFor every 5 full ranks in a relevant skill, the leader may increase the leadership modifier by an additional 1.Warden: Knowledge (engineering)"},{"row":64,"column":14,"value":"Loyalty"},{"row":64,"column":16,"value":"Recruitment"},{"row":64,"column":18,"value":"Normal"},{"row":68,"column":2,"value":"Comments"}]},{"name":"Kingdom","nonemptyRows":67,"maxRow":86,"maxColumn":61,"formulaCount":305,"inputCount":174,"functions":{"SUM":8,"ROUNDDOWN":6,"INT":4},"dependencies":{},"formulas":[{"row":4,"column":4,"formula":"of:=[.BI76]","cached":"0"},{"row":6,"column":4,"formula":"of:=ROUNDDOWN((SUM([.R22:.R89]));0)","cached":"0"},{"row":8,"column":4,"formula":"of:=ROUNDDOWN((SUM([.S22:.S89]));0)","cached":"0"},{"row":10,"column":4,"formula":"of:=ROUNDDOWN((SUM([.T22:.T89]));0)","cached":"0"},{"row":12,"column":4,"formula":"of:=ROUNDDOWN((SUM([.U22:.U89]));0)","cached":"0"},{"row":14,"column":4,"formula":"of:=ROUNDDOWN((SUM([.V22:.V89]));0)","cached":"0"},{"row":16,"column":4,"formula":"of:=ROUNDDOWN((SUM([.W22:.W89]));0)","cached":"0"},{"row":22,"column":18,"formula":"of:=[.$D22]*[.F22]","cached":"0"},{"row":22,"column":19,"formula":"of:=[.$D22]*[.H22]","cached":"0"},{"row":22,"column":20,"formula":"of:=[.$D22]*[.J22]","cached":"0"},{"row":22,"column":21,"formula":"of:=[.$D22]*[.L22]","cached":"0"},{"row":22,"column":22,"formula":"of:=[.$D22]*[.N22]","cached":"0"},{"row":22,"column":23,"formula":"of:=[.$D22]*[.P22]","cached":"0"},{"row":22,"column":61,"formula":"of:=[.$AE22]*[.AG22]+[.AM22]*25+[.AO2