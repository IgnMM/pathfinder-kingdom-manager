on"},{"row":330,"column":6,"value":"Crime"},{"row":330,"column":11,"value":"Corruption"},{"row":330,"column":15,"value":"Crime"},{"row":332,"column":2,"value":"Productivity"},{"row":332,"column":6,"value":"Law"},{"row":332,"column":11,"value":"Productivity"},{"row":332,"column":15,"value":"Law"},{"row":334,"column":2,"value":"Lore"},{"row":334,"column":6,"value":"Society"},{"row":334,"column":11,"value":"Lore"},{"row":334,"column":15,"value":"Society"},{"row":336,"column":2,"value":"Magic Item Slots"},{"row":336,"column":6,"value":"Major Buildings"},{"row":336,"column":11,"value":"Magic Item Slots"},{"row":336,"column":15,"value":"Major Buildings"},{"row":338,"column":2,"value":"Major"},{"row":338,"column":11,"value":"Major"},{"row":340,"column":2,"value":"Medium"},{"row":340,"column":11,"value":"Medium"},{"row":342,"column":2,"value":"Minor"},{"row":342,"column":11,"value":"Minor"},{"row":344,"column":2,"value":"Comments"},{"row":344,"column":11,"value":"Comments"},{"row":354,"column":2,"value":"Name"},{"row":354,"column":11,"value":"Name"},{"row":356,"column":2,"value":"Economy"},{"row":356,"column":6,"value":"Population"},{"row":356,"column":11,"value":"Economy"},{"row":356,"column":15,"value":"Population"},{"row":358,"column":2,"value":"Loyalty"},{"row":358,"column":6,"value":"Defense"},{"row":358,"column":11,"value":"Loyalty"},{"row":358,"column":15,"value":"Defense"},{"row":360,"column":2,"value":"Stability"},{"row":360,"column":6,"value":"Base Value"},{"row":360,"column":11,"value":"Stability"},{"row":360,"column":15,"value":"Base Value"},{"row":362,"column":2,"value":"Corruption"},{"row":362,"column":6,"value":"Crime"},{"row":362,"column":11,"value":"Corruption"},{"row":362,"column":15,"value":"Crime"},{"row":364,"column":2,"value":"Productivity"},{"row":364,"column":6,"value":"Law"},{"row":364,"column":11,"value":"Productivity"},{"row":364,"column":15,"value":"Law"},{"row":366,"column":2,"value":"Lore"},{"row":366,"column":6,"value":"Society"},{"row":366,"column":11,"value":"Lore"},{"row":366,"column":15,"value":"Society"},{"row":368,"column":2,"value":"Magic Item Slots"},{"row":368,"column":6,"value":"Major Buildings"},{"row":368,"column":11,"value":"Magic Item Slots"},{"row":368,"column":15,"value":"Major Buildings"},{"row":370,"column":2,"value":"Major"},{"row":370,"column":11,"value":"Major"},{"row":372,"column":2,"value":"Medium"},{"row":372,"column":11,"value":"Medium"},{"row":374,"column":2,"value":"Minor"},{"row":374,"column":11,"value":"Minor"},{"row":376,"column":2,"value":"Comments"},{"row":376,"column":11,"value":"Comments"},{"row":386,"column":2,"value":"Name"},{"row":388,"column":2,"value":"Economy"},{"row":388,"column":6,"value":"Population"},{"row":390,"column":2,"value":"Loyalty"},{"row":390,"column":6,"value":"Defense"},{"row":392,"column":2,"value":"Stability"},{"row":392,"column":6,"value":"Base Value"},{"row":394,"column":2,"value":"Corruption"},{"row":394,"column":6,"value":"Crime"},{"row":396,"column":2,"value":"Productivity"},{"row":396,"column":6,"value":"Law"},{"row":398,"column":2,"value":"Lore"},{"row":398,"column":6,"value":"Society"},{"row":400,"column":2,"value":"Magic Item Slots"},{"row":400,"column":6,"value":"Major Buildings"},{"row":402,"column":2,"value":"Major"},{"row":404,"column":2,"value":"Medium"},{"row":406,"column":2,"value":"Minor"},{"row":408,"column":2,"value":"Comments"}]},{"name":"Turn_Sequence","nonemptyRows":19,"maxRow":19,"maxColumn":6,"formulaCount":0,"inputCount":58,"functions":{},"dependencies":{},"formulas":[],"inputs":[{"row":1,"column":1,"value":"Phases"},{"row":1,"column":3,"value":"Upkeep Phase"},{"row":1,"column":4,"value":"Check"},{"row":1,"column":5,"value":"Jody Cummings:If a Check is made the value in this column is for succeeding at the Check.If no Check is required, then the value in this column is something that must be done.Succeed or Do Task"},{"row":1,"column":6,"value":"Jody Cummings:If a Check is made the value in this column is for succeeding at the Check.If no Check is required, then the value in this column is something that must be done.Failure or Do Task"},{"row":2,"column":1,"value":"Phase 1—Upkeep"},{"row":2,"column":3,"value":"Step 1—Determine Kingdom Stability"},{"row":2,"column":4,"value":"Stability"},{"row":2,"column":5,"value":"Unrest decreases by 1if this would reduce Unrest below 0, add 1 BP to your Treasury instead."},{"row":2,"column":6,"value":"If you fail by 4 or less, Unrest increases by 1;if you fail by 5 or more, Unrest increases by 1d4"},{"row":3,"column":1,"value":"Phase 2—Edict"},{"row":3,"column":3,"value":"Step 2—Pay Consumption"},{"row":3,"column":5,"value":"Subtract your kingdom’s Consumption from the kingdom’s Treasury"},{"row":3,"column":6,"value":"If your Treasury is negative after paying Consumption, Unrest increases by 2"},{"row":4,"column":1,"value":"Phase 3—Income"},{"row":4,"column":3,"value":"Step 3—Fill Vacant Magic Item Slots"},{"row":4,"column":5,"value":"If any of your settlement districts have buildings that produce magic items (such as a Caster’s Tower or Herbalist) with vacant magic item slots, there is a chance of those slots filling with new items"},{"row":5,"column":1,"value":"Phase 4—Event"},{"row":5,"column":3,"value":"Step 4—Modify Unrest"},{"row":5,"column":5,"value":"Unrest increases by 1 for each kingdom attribute (Economy, Loyalty, or Stability) that is a negative number"},{"row":5,"column":6,"value":"The Royal Enforcer may attempt to reduce Unrest during this step.If the kingdom’s Unrest is 11 or higher, it loses 1 hex (leaders choose hex)"},{"row":6,"column":3,"value":"Edict Phase"},{"row":6,"column":4,"value":"Check"},{"row":6,"column":5,"value":"Jody Cummings:If a Check is made the value in this column is for succeeding at the Check.If no Check is required, then the value in this column is something that must be done.Succeed or Do Task"},{"row":6,"column":6,"value":"Jody Cummings:If a Check is made the value in this column is for succeeding at the Check.If no Check is required, then the value in this column is something that must be done.Failure or Do Task"},{"row":7,"column":3,"value":"Step 1—Assign Leadership"},{"row":7,"column":5,"value":"Assign PCs or NPCs to any vacant leadership roles or change the roles being filled by particular PCs or closely allied NPCs"},{"row":8,"column":3,"value":"Step 2—Claim and Abandon Hexes"},{"row":8,"column":5,"value":"Claim Hex1 - You can only claim a hex that is adjacent to at least 1 other hex in your kingdom2 - Before you can claim it, the hex must first be explored, then cleared of monsters anddangerous hazards3 - Then, to claim the hex, spend 1 BP; this establishes the hex as part of your kingdomand increases your kingdom’s Size by 1"},{"row":8,"column":6,"value":"Abandon Hex1 - You may abandon any number of hexes to reduce your kingdom’s Size2 - Doing so increases Unrest by 1 for each hex abandoned (or by 4 if the hex contained asettlement)"},{"row":9,"column":3,"value":"Step 4—Build Terrain Improvements"},{"row":9,"column":5,"value":"You may spend BP to build terrain improvements like Farms, Forts, Roads, Mines,and Quarries (see Terrain Improvements, starting on page 210)"},{"row":10,"column":3,"value":"Step 5—Create and Improve Settlements"},{"row":10,"column":5,"value":"1 - You may create a settlement in a claimed hex2 - You may construct a building(s) in any settlement in your kingdom"},{"row":11,"column":3,"value":"Step 6—Create Army Units"},{"row":11,"column":5,"value":"You may create, expand, equip, or repair army units"},{"row":12,"column":3,"value":"Step 7—Issue Edicts"},{"row":12,"column":5,"value":"Select or adjust your edict levels (Holiday, Improvement, Promotion or Taxation Edicts)"},{"row":13,"column":3,"value":"Income Phase"},{"row":13,"column":4,"value":"Check"},{"row":13,"column":5,"value":"Jody Cummings:If a Check is made the value in this column is for succeeding at the Check.If no Check is required, then the value in this column is something that must be done.Succeed or Do Task"},{"row":13,"column":6,"value":"Jody Cummings:If a Check is made the value in this column is for succeeding at the Check.If no Check is required, then the value in this column is something that must be done.Failure or Do Task"},{"row":14,"column":3,"value":"Step 1—Make Withdrawals from the Treasury"},{"row":14,"column":5,"value":"1 - If withdrawing for personal use, Unrest increases by the number of BP withdrawn.2 - Each BP you withdraw this way converts to 2,000 gp of personal funds."},{"row":15,"column":3,"value":"Step 2—Make Deposits to the Treasury"},{"row":15,"column":5,"value":"1 - You can add funds to a kingdom’s Treasury by donating your personal wealth to the kingdom—coins, gems, jewelry,weapons, armor, magic items, and other valuables found while adventuring, as long as they are individually worth 4,000 gp less2 - For every full 4,000 gp in value of the deposit, increase your kingdom’s BP by 1"},{"row":16,"column":3,"value":"Step 3—Sell Expensive Items for BP"},{"row":16,"column":5,"value":"1 - You can attempt to sell expensive personal items (that is, items worth more than 4,000 gp each) through your kingdom’s markets to add to your Treasury. You may sell one item per settlement district per turn. You must choose the settlement where you want to sell the item, and the item cannot be worth more than the base value of that settlement (see page 212).2 - To sell an item, divide its price by half (as if selling it to an NPC for gp), divide the result by 4,000 (rounded down), and add that many BP to your Treasury."},{"row":17,"column":3,"value":"Step 4—Collect Taxes"},{"row":17,"column":4,"value":"Economy"},{"row":17,"column":5,"value":"\"Attempt an Economy check, divide the result by the revenue divisor, and add a number of BP to your Treasury equal to the result"},{"row":18,"column":3,"value":"Event Phase"},{"row":18,"column":4,"value":"Check"},{"row":18,"column":5,"value":"Jody Cummings:If a Check is made the value in this column is for succeeding at the Check.If no Check is required, then the value in this column is something that must be done.Succeed or Do Task"},{"row":18,"column":6,"value":"Jody Cummings:If a Check is made the value in this column is for succeeding at the Check.If no Check is required, then the value in this column is something that must be done.Failure or Do Task"},{"row":19,"column":3,"value":"Step 1—Check for Event (see Event sheet)"},{"row":19,"column":4,"value":"DM Rolled"},{"row":19,"column":5,"value":"1 - There is a25%chance of an event occurring (see Events, starting on page 220).2 - If no event occurred during the last turn, this chance increases to75%."}]},{"name":"Events","nonemptyRows":35,"maxRow":37,"maxColumn":12,"formulaCount":0,"inputCount":134,"functions":{},"dependencies":{},"formulas":[],"inputs":[{"row":2,"column":2,"value":"d%"},{"row":2,"column":3,"value":"Type of Event"},{"row":2,"column":5,"value":"Table: Beneficial Kingdom Events"},{"row":2,"column":8,"value":"Table: Dangerous Kingdom Events"},{"row":3,"column":2,"value":"01-50"},{"row":3,"column":3,"value":"Kingdom Event (choose a random hex)"},{"row":3,"column":5,"value":"d%"},{"row":3,"column":6,"value":"Event"},{"row":3,"column":8,"value":"d%+Danger"},{"row":3,"column":9,"value":"Event"},{"row":4,"column":2,"value":"51-00"},{"row":4,"column":3,"value":"Settlement Event (choose a random settlement)"},{"row":4,"column":5,"value":"01-11"},{"row":4,"column":6,"value":"Jody Cummings:Good weather raises spirits and productivity. Economy, Loyalty, and Productivity increase by 2 until the next Event PhaseGood weather"},{"row":4,"column":8,"value":"<1"},{"row":4,"column":9,"value":"No event"},{"row":5,"column":5,"value":"12-23"},{"row":5,"column":6,"value":"Jody Cummings:Farmers produce an unexpected windfall! In the next Upkeep Phase, the kingdom's Consumption is halved (but returns to normal on the next turn)Food surplus"},{"row":5,"column":8,"value":"01-10"},{"row":5,"column":9,"value":"Jody Cummings:Spoilage, treachery, or bad luck has caused a food shortage this turn. Attempt a Stability check. If you succeed, Consumption in the next Upkeep Phase increases by 50%. If you fail, Consumption in the next Upkeep Phase increases by 100%Food shortage"},{"row":6,"column":5,"value":"24-35"},{"row":6,"column":6,"value":"Jody Cummings:Trade is booming in your kingdom! Your Treasury increases by 1d6 BP (each time you roll a 6, add the result to the total and roll again)Economic boom"},{"row":6,"column":8,"value":"11-20"},{"row":6,"column":9,"value":"Jody Cummings:Bandits are preying upon those who travel through your kingdom. Attempt a Stability check. If you succeed, your kingdom's defenses stop the bandits before they cause any harm. If you fail, the bandits reduce your kingdom's Treasury by 1d6 BP (each time you roll a 6, add the result to the total and roll again)Bandit activity"},{"row":7,"column":2,"value":"d%+ Danger"},{"row":7,"column":3,"value":"Danger Level of Event"},{"row":7,"column":5,"value":"36-43"},{"row":7,"column":6,"value":"Jody Cummings:Scholars unearth a bit of ancient lore or devise important new research of their own. Fame increases by 1 and Lore increases by 1d4Discovery"},{"row":7,"column":8,"value":"21-30"},{"row":7,"column":9,"value":"Jody Cummings:This event is identical to the building demand event, but the citizens want the construction or destruction of a terrain improvement in the hexImprovement demand"},{"row":8,"column":2,"value":"less than 1"},{"row":8,"column":3,"value":"Reroll* plus bonus event1"},{"row":8,"column":5,"value":"44-53"},{"row":8,"column":6,"value":"Jody Cummings:A natural event, such as a bloom of rare and beautiful wildflowers or a good omen in the stars, raises your kingdom's morale. You gain a +4 bonus on Stability checks until the next Event PhaseNatural blessing"},{"row":8,"column":8,"value":"31-38"},{"row":8,"column":9,"value":"Jody Cummings:Zealots mobilize public opinion against a particular race, religion, kingdom, behavior, or kingdom leader. Attempt a Loyalty check. If you fail, the zealots run rampant; Infamy and Law increase by 1 and Lore, Loyalty, Productivity, and Stability decrease by 2. If you succeed, the zealots are somewhat suppressed; Lore, Loyalty, Productivity, and Stability decrease by 1. Two successful checks in a row end the event (if a check ends the event, no penalties from it occur that turn)Inquisition"},{"row":9,"column":2,"value":"01-50"},{"row":9,"column":3,"value":"Beneficial Event"},{"row":9,"column":5,"value":"54-62"},{"row":9,"column":6,"value":"Jody Cummings:A sudden absence of political machinations coincides with an increase in public approval. Unrest decreases by 1d6. Until the next Event Phase, you gain a +2 bonus on checks to resolve continuous events. If your kingdom has no Unrest and no continuous events, both Loyalty and Stability increase by 1. If you are using Law settlement modifiers for the kingdom (see Expanding Settlement Modifiers), this also increases Law by 1 for the entire kingdomPolitical calm"},{"row":9,"column":8,"value":"39-46"},{"row":9,"column":9,"value":"Jody Cummings:One of your leaders is implicated in a crime or an embarrassing situation, such as an affair with another leader's spouse. Infamy increases by 1. Attempt a Loyalty check. If you fail, Unrest increases by 2 and you take a –4 penalty on all Loyalty checks until the next Event PhasePublic scandal"},{"row":10,"column":2,"value":"51-00"},{"row":10,"column":3,"value":"Dangerous Event"},{"row":10,"column":5,"value":"63-69"},{"row":10,"column":6,"value":"Jody Cummings:Your kingdom's leaders are invited to a festival in a neighboring kingdom. If you attend and bring 1d4 BP worth of gifts, for 1 year Society increases by 1, Fame increases by 1 for any check relating to that kingdom, and you gain a +2 bonus on edict checks relating to that kingdomFestive invitation"},{"row":10,"column":8,"value":"47-53"},{"row":10,"column":9,"value":"Jody Cummings:Unscrupulous merchants are subverting legitimate businesses. Attempt a Loyalty check and a Stability check...Penalty :A penalty equal to the number of Piers, Waterfronts, and trade routes in the kingdom.Success :If you succeed at both checks, the smugglers are stopped before your kingdom takes any penalties from the event.Failure :If you fail atoneof the checks, Corruption increases by 1d2 in each settlement, Crime increases by 1 for the kingdom (Optional Kingdom Rules), Productivity for the kingdom decreases by 1d3, Treasury decreases by 1d3 BP, and the event is not continuous.If you fail atbothof the checks, Corruption increases by 1d4, Crime for the kingdom increases by 1, Productivity for the kingdom decreases by 1d6, Treasury decreases by 1d6 BP, and the event is continuousSmugglers"},{"row":11,"column":2,"value":"Over 100"},{"row":11,"column":3,"value":"Reroll* plus bonus event2"},{"row":11,"column":5,"value":"70-76"},{"row":11,"column":6,"value":"Jody Cummings:A small group of indigenous intelligent creatures joins your kingdom and submits to your rule. Society and Stability increase by 1, Unrest decreases by 1, and your Treasury increases by 1d6 BP (each time you roll a 6, add the result to the total and roll again)New subjects"},{"row":11,"column":8,"value":"54-60"},{"row":11,"column":9,"value":"Jody Cummings:Nobles (or other influential rival groups) are bickering. Attempt a Loyalty check. If you succeed, you end the event but Unrest increases by 1. If you fail, Corruption increases by 1, Unrest increases by 1d6, and the event is continuousFeud"},{"row":12,"column":5,"value":"77-84"},{"row":12,"column":6,"value":"Jody Cummings:A nearby kingdom sends an ambassador to you to negotiate an embassy (01–60), treaty (61–90), or alliance (91–100), as if using a diplomatic edict (see Special Edicts). If the GM doesn't have an appropriate kingdom in mind when this event occurs, determine the kingdom's alignment randomly; it may be hostile or friendly. The ambassador bears 1d4 BP worth of gifts for your kingdomDiplomatic overture"},{"row":12,"column":8,"value":"61-68"},{"row":12,"column":9,"value":"Jody Cummings:A serial killer, arsonist, or daring bandit plagues your kingdom. Attempt two Stability checks, adding the settlement's Law and subtracting its Crime. If you succeed at both checks, the criminal is caught before your kingdom takes any penalties from the event. If you fail at one, the criminal escapes, Unrest increases by 1, and the event is continuous. If you fail at both, the criminal makes a fool of the authorities; Law and Loyalty decrease by 1, Treasury decreases by 1d4 BP, Unrest increases by 2, and the event is continuousSensational crime"},{"row":13,"column":3,"value":"*: Do not apply danger level to rerolls. In addition, if the reroll duplicates the bonus event, roll again"},{"row":13,"column":5,"value":"85-92"},{"row":13,"column":6,"value":"Jody Cummings:A well-preserved ruin is found in your kingdom, with historical artifacts connected to the people who lived in your land long ago. Effect: Lore +1. If you have a Museum, the discoverers donate 10,000 gp worth of historical artifacts to its collection (if you have multiple Museums, choose one as the recipient)Archaeological find"},{"row":13,"column":8,"value":"69-77"},{"row":13,"column":9,"value":"Jody Cummings:A monster (or group of monsters) attacks the kingdom. The GM picks a claimed hex in the kingdom in which the monster is active. The CR of the monster encounter is equal to the party's APL + 1d4 – 1. You can personally deal with the monster (earning XP and treasure normally for your efforts) or succeed at a Stability check to eliminate it (which doesn't affect you or the kingdom's statistics). If the monster is not defeated this turn, Unrest increases by 4. If the kingdom's Unrest is 5 or higher, the monster's hex becomes unclaimed—this is in addition to losing control of hexes in the Upkeep Phase because of the kingdom's high Unrest scoreMonster attack"},{"row":14,"column":3,"value":"1: 50% chance of either: Good weather or Natural blessing (kingdom event); or Boomtown or Unexpected Find (settlement event)"},{"row":14,"column":5,"value":"93-00"},{"row":14,"column":6,"value":"Jody Cummings:Overeager settlers claim an unclaimed hex and construct a Farm, Mine, Quarry, or Sawmill at their own expense, but are fighting over ownership. This hex is not part of your kingdom, so you gain no benefits from it. Productivity, Society, and Stability decrease by 1. Attempt a Loyalty check. If you succeed, Unrest increases by 1. If you fail, Unrest increases by 1d4. If you construct an identical improvement in an adjacent hex during your next Edict Phase, remove this event's changes to Productivity, Society, and StabilityLand rush"},{"row":14,"column":8,"value":"78-84"},{"row":14,"column":9,"value":"Jody Cummings:A religious cult of an alignment opposed to the kingdom's alignment begins kidnapping, converting, or even publicly sacrificing citizens. Attempt a Loyalty check and a Stability check. If both succeed, the cult is disbanded before your kingdom takes any penalties from the event. For each of these checks you fail, Unrest increases by 1 and Productivity, Society, and Stability decrease by 1. If both checks fail, the event continues in the next Event PhaseCult activity"},{"row":15,"column":3,"value":"2: 50% chance of either: Monster attack or Bandit activity (kingdom event); or Squatters or Vandals (settlement event)"},{"row":15,"column":8,"value":"85-90"},{"row":15,"column":9,"value":"Jody Cummings:A deadly sickness strikes the target hex or settlement. You cannot construct terrain improvements or buildings there while plague persists. Attempt two Stability checks...Penalty :A penalty equal to the number of Brothels, Foreign Quarters, Highways, Inns, Piers, Roads, Stables, Stockyards, Tenements, and Waterfronts in the hex.Bonus :A bonus equal to the number of Cathedrals, Herbalists, Hospitals, and Temples in the hex.Succeed :If you succeed at both checks, the event ends, but Stability decreases by 2 and Treasury by 1d3 BP.Failure :If you fail at one check, Stability decreases by 4, Treasury decreases by 1d6 BP, and Unrest increases by 1d3.If you fail at both, Stability decreases by 4, Treasury decreases by 1d6 BP, Unrest increases by 1d6, and in the next Event Phase the plague spreads to an adjacent hexPlague"},{"row":16,"column":8,"value":"91-95"},{"row":16,"column":9,"value":"Jody Cummings:One of your leaders (determined randomly) is the target of an assassination attempt. If the target is a PC, the GM should run the attempt as an encounter, using an assassin of a CR equal to the targeted PC's level. If the target is an NPC, you must succeed at a Stability check to prevent the assassination. If the assassination occurs, Unrest increases by 1d6 and the kingdom immediately incurs the penalties for not having a leader in that roleAssassination attempt"},{"row":17,"column":8,"value":"96-00"},{"row":17,"column":9,"value":"Jody Cummings:A fire, storm, earthquake, flood, massive sabotage, or other disaster strikes! Roll 1d6; on a result of 1–5, the disaster threatens only 1 improved hex. On a result of 6, the disaster is widespread and threatens 1d6 additional improved hexes adjacent to the target hex. Attempt a Stability check for each threatened hex; failure means the disaster destroys one terrain improvement in the hex and Unrest increases by 1. (This Stability check represents your kingdom's ability to prepare for or react to the disaster as well as the structure's ability to withstand damage.)Large disaster"},{"row":18,"column":8,"value":"101+"},{"row":18,"column":9,"value":"Roll twice1"},{"row":19,"column":12,"value":"1: Use the more severe of the two results (or the GM may choose which result to apply). Do not apply the Danger modifier to these rolls. If both rolls give the same event, use that event. If one of these rolls duplicates a bonus event, roll again."},{"row":21,"column":5,"value":"Table: Beneficial Settlement Events"},{"row":21,"column":8,"value":"Table: Dangerous Settlement Events"},{"row":22,"column":5,"value":"d%"},{"row":22,"column":6,"value":"Event"},{"row":22,"column":8,"value":"d%+Danger"},{"row":22,"column":9,"value":"Event"},{"row":23,"column":5,"value":"01–14"},{"row":23,"column":6,"value":"Jody Cummings:Randomly select one settlement. Commerce booms among that settlement. Until the next Event Phase, Economy increases by the number of buildings in the settlement that grant an Economy bonus, and Corruption increases by 1d4 in that settlementBoomtown"},{"row":23,"column":8,"value":"<1"},{"row":23,"column":9,"value":"No event"},{"row":24,"column":5,"value":"15–26"},{"row":24,"column":6,"value":"Jody Cummings:A noble family offers to construct a Monument (01–50) or Park (51–100) in your settlement at the family's own expense. The nobles pay all costs and Consumption for this purposeNoblesse oblige"},{"row":24,"column":8,"value":"01-10"},{"row":24,"column":9,"value":"Jody Cummings:The citizens demand a particular building be built (01–75) or demolished (76–100). Select the building type randomly from those available for the settlement. If the demand is not met by the next Event Phase, Unrest increases by 1. Alternatively, you can suppress the citizens' demands and negate the event by succeeding at a Loyalty check, but this reduces Loyalty by 2 and increases Unrest by 1Building demand"},{"row":25,"column":5,"value":"27–40"},{"row":25,"column":6,"value":"Jody Cummings:One of your kingdom's citizens creates an artistic masterpiece, constructs a particularly impressive building, or otherwise brings glory to your kingdom. Fame increases by 1, your Treasury increases by 1d6 BP, and Unrest decreases by 2. You gain a +4 bonus on Economy checks until the next Event PhaseOutstanding success"},{"row":25,"column":8,"value":"11-20"},{"row":25,"column":9,"value":"Jody Cummings:An empty settlement lot is taken over by beggars, troublemakers, and people unable to find adequate work or housing; they camp there with tents, wagons, and shanties. You cannot use the lot for anything until the squatters are dispersed. Fame and Stability decrease by 1, and Unrest increases by 2. You may try to disperse the squatters with a Stability check. Success means the squatters are dispersed and the event is not continuous, but if a House or Tenement is not built in that lot on the next turn, Infamy increases by 1 and Unrest by 2. Failing the Stability check means the event is continuous, and you may not build on that lot until the event is resolvedSquatters"},{"row":26,"column":5,"value":"41–46"},{"row":26,"column":6,"value":"Jody Cummings:The settlement immediately fills one of its open magic item slots (selected randomly) with a better than normal item (medium if a minor slot, major if a medium slot). Treat the settlement's base value as 50% higher than normal for determining the item's maximum price. If the settlement doesn't have any open magic item slots, treat this event as Unexpected FindRemarkable treasure"},{"row":26,"column":8,"value":"21-27"},{"row":26,"column":9,"value":"Jody Cummings:Pests, blight, and weather ruin the harvest in the settlement's hex and all adjacent hexes. Attempt two Stability checks. If both succeed, the problem is fixed before your kingdom takes any penalties from the event. If only one succeeds, affected farms reduce Consumption by 1 (instead of the normal reduction) in the next Upkeep Phase. If neither succeeds, affected farms do not reduce Consumption at all in the next Upkeep PhaseCrop failure"},{"row":27,"column":5,"value":"47–58"},{"row":27,"column":6,"value":"Jody Cummings:A celebrity from another kingdom visits one of your settlements, causing a sudden influx of other visitors and spending. Fame increases by 1 and Treasury increases by 1d6 BP (each time you roll a 6, add the result to the total and roll again)Visiting celebrity"},{"row":27,"column":8,"value":"28-35"},{"row":27,"column":9,"value":"Jody Cummings:Zealots mobilize public opinion against a particular race, religion, kingdom, behavior, or kingdom leader. Attempt a Loyalty check. If you fail, the zealots run rampant; Infamy and Law increase by 1 and Lore, Loyalty, Productivity, and Stability decrease by 2. If you succeed, the zealots are somewhat suppressed; Lore, Loyalty, Productivity, and Stability decrease by 1. Two successful checks in a row end the event (if a check ends the event, no penalties from it occur that turn)Inquisition"},{"row":28,"column":5,"value":"59–66"},{"row":28,"column":6,"value":"Jody Cummings:Authorities shut down a major criminal operation or thwart a plot against the settlement. Law and Loyalty increase by 1 and Crime and Unrest decreases by 1Justice prevails"},{"row":28,"column":8,"value":"36-45"},{"row":28,"column":9,"value":"Jody Cummings:Thugs and dissidents riot and destroy property. Attempt a Loyalty check and a Stability check. If you succeed at both, the vandals are stopped before your kingdom takes any penalties. If you fail at one check, Society decreases by 1 and one random building in the settlement is damaged. If you fail at both, one random building is destroyed (Unrest increases by 1 for each lot of the destroyed building), and 1d3 other random buildings are damaged. a damaged building provides no benefits until half its cost is spent repairing itVandals"},{"row":29,"column":5,"value":"67–72"},{"row":29,"column":6,"value":"Jody Cummings:Scholars unearth a bit of ancient lore or devise important new research of their own. Fame increases by 1 and Lore increases by 1d4Discovery"},{"row":29,"column":8,"value":"46-53"},{"row":29,"column":9,"value":"Jody Cummings:One of your Houses or Tenements becomes a hive of illicit drug trade. Attempt a Loyalty check and a Stability check, with a penalty equal to the number of Brothels, Tenements, Waterfronts, and lots with squatters in the settlement. If you succeed at both checks, you eliminate the drug den before your kingdom takes any penalties from the event. If you fail at one check, Crime and Unrest increase by 1. If you fail at both checks, Crime and Unrest increase by 1; Economy, Loyalty, and Stability decrease by 1; and on the next Event Phase, a second drug den event occurs in the same settlement (01–50) or the nearest settlement (51–100)Drug den"},{"row":30,"column":5,"value":"73–81"},{"row":30,"column":6,"value":"Jody Cummings:Randomly select one settlement with a Cathedral, Shrine, or Temple. Pious religious folk journey to your settlement, holding a religious festival in that settlement at no BP cost to youPilgrimage"},{"row":30,"column":8,"value":"54-59"},{"row":30,"column":9,"value":"Jody Cummings:Criminals begin kidnapping citizens and selling them into slavery. Attempt a Loyalty check and a Stability check, each with a penalty equal to the number of Brothels, Tenements, Waterfronts, and lots with squatters in the settlement. If you succeed at both checks, the slavers are caught before your kingdom takes any penalties from the event. If you fail at one of the checks, Loyalty, Stability, and Unrest decrease by 1, but the event is not continuous. If you fail at both checks, Loyalty, Stability, and Unrest decrease by 2, and the event is continuousSlavers"},{"row":31,"column":5,"value":"82–93"},{"row":31,"column":6,"value":"Jody Cummings:Local citizens discover a forgotten magical item. The settlement gains one temporary minor (01–70) or medium (71–100) magic item slot that is automatically filled in the next Upkeep Phase. This slot and the item go away if the item is purchased or in the next Event Phase, whichever comes firstUnexpected find"},{"row":31,"column":8,"value":"60-67"},{"row":31,"column":9,"value":"Jody Cummings:Nobles (or other influential rival groups) are bickering. Attempt a Loyalty check. If you succeed, you end the event but Unrest increases by 1. If you fail, Corruption increases by 1, Unrest increases by 1d6, and the event is continuousFeud"},{"row":32,"column":5,"value":"94–100"},{"row":32,"column":6,"value":"Jody Cummings:A rich merchant or a noble from another land is impressed with your kingdom and asks to construct a Mansion (01–75) or Noble Villa (76–100) in the settlement at no cost to you. If you allow it, the building provides its normal benefits to your kingdomWealthy immigrant"},{"row":32,"column":8,"value":"68-75"},{"row":32,"column":9,"value":"Jody Cummings:A religious cult of an alignment opposed to the kingdom's alignment begins kidnapping, converting, or even publicly sacrificing citizens. Attempt a Loyalty check and a Stability check. If both succeed, the cult is disbanded before your kingdom takes any penalties from the event. For each of these checks you fail, Unrest increases by 1 and Productivity, Society, and Stability decrease by 1. If both checks fail, the event continues in the next Event PhaseCult activity"},{"row":33,"column":8,"value":"76-83"},{"row":33,"column":9,"value":"Jody Cummings:A serial killer, arsonist, or daring bandit plagues your kingdom. Attempt two Stability checks, adding the settlement's Law and subtracting its Crime. If you succeed at both checks, the criminal is caught before your kingdom takes any penalties from the event. If you fail at one, the criminal escapes, Unrest increases by 1, and the event is continuous. If you fail at both, the criminal makes a fool of the authorities; Law and Loyalty decrease by 1, Treasury decreases by 1d4 BP, Unrest increases by 2, and the event is continuousSensational crime"},{"row":34,"column":8,"value":"84-90"},{"row":34,"column":9,"value":"Jody Cummings:A monster (or group of monsters) attacks the kingdom. The GM picks a claimed hex in the kingdom in which the monster is active. The CR of the monster encounter is equal to the party's APL + 1d4 – 1. You can personally deal with the monster (earning XP and treasure normally for your efforts) or succeed at a Stability check to eliminate it (which doesn't affect you or the kingdom's statistics). If the monster is not defeated this turn, Unrest increases by 4. If the kingdom's Unrest is 5 or higher, the monster's hex becomes unclaimed—this is in addition to losing control of hexes in the Upkeep Phase because of the kingdom's high Unrest scoreMonster attack"},{"row":35,"column":8,"value":"91-95"},{"row":35,"column":9,"value":"Jody Cummings:A deadly sickness strikes the target hex or settlement. You cannot construct terrain improvements or buildings there while plague persists. Attempt two Stability checks...Penalty :A penalty equal to the number of Brothels, Foreign Quarters, Highways, Inns, Piers, Roads, Stables, Stockyards, Tenements, and Waterfronts in the hex.Bonus :A bonus equal to the number of Cathedrals, Herbalists, Hospitals, and Temples in the hex.Succeed :If you succeed at both checks, the event ends, but Stability decreases by 2 and Treasury by 1d3 BP.Failure :If you fail at one check, Stability decreases by 4, Treasury decreases by 1d6 BP, and Unrest increases by 1d3.If you fail at both, Stability decreases by 4, Treasury decreases by 1d6 BP, Unrest increases by 1d6, and in the next Event Phase the plague spreads to an adjacent hexPlague"},{"row":36,"column":8,"value":"96-00"},{"row":36,"column":9,"value":"Jody Cummings:A fire, a flood, a storm, an earthquake, massive sabotage, or another disaster strikes the settlement! Roll 1d6 to determine how many lots are threatened by the disaster. On a result of 6, the disaster is widespread and affects 1d6 additional adjacent lots. Attempt a Stability check for each threatened lot; failure means the disaster destroys the building in that lot and Unrest increases by 1. (This Stability check represents your kingdom's ability to prepare for or react to the disaster as well as the structure's ability to withstand damage.)Localized disaster"},{"row":37,"column":8,"value":"100+"},{"row":37,"column":9,"value":"Roll twice1"}]},{"name":"Charts","nonemptyRows":0,"maxRow":0,"maxColumn":0,"formulaCount":0,"inputCount":0,"functions":{},"dependencies":{},"formulas":[],"inputs":[]},{"name":"Buildings","nonemptyRows":94,"maxRow":94,"maxColumn":46,"formulaCount":0,"inputCount":2186,"functions":{},"dependencies":{},"formulas":[],"inputs":[{"row":1,"column":1,"value":"Building"},{"row":1,"column":2,"value":"BP Cost"},{"row":1,"column":3,"value":"Population"},{"row":1,"column":4,"value":"# of Lots"},{"row":1,"column":5,"value":"Economy"},{"row":1,"column":6,"value":"Loyalty"},{"row":1,"column":7,"value":"Stability"},{"row":1,"column":8,"value":"Economy/BP"},{"row":1,"column":9,"value":"Loyalty/BP"},{"row":1,"column":10,"value":"Stability/BP"},{"row":1,"column":11,"value":"Unrest"},{"row":1,"column":12,"value":"Unrest/BP"},{"row":1,"column":13,"value":"Fame"},{"row":1,"column":14,"value":"infamy"},{"row":1,"column":15,"value":"Corruption"},{"row":1,"column":16,"value":"Crime"},{"row":1,"column":17,"value":"Productivity"},{"row":1,"column":18,"value":"Law"},{"row":1,"column":19,"value":"Lore"},{"row":1,"column":20,"value":"Society"},{"row":1,"column":21,"value":"Discount"},{"row":1,"column":22,"value":"Upgrade From"},{"row":1,"column":23,"value":"Upgrade To"},{"row":1,"column":24,"value":"Limit"},{"row":1,"column":25,"value":"Special"},{"row":1,"column":26,"value":"Magic Items"},{"row":1,"column":27,"value":"Description"},{"row":1,"column":28,"value":"Column1"},{"row":1,"column":29,"value":"Defense"},{"row":1,"column":30,"value":"Base Value"},{"row":1,"column":31,"value":"Column2"},{"row":1,"column":32,"value":"Minor Scroll/Wondrous"},{"row":1,"column":33,"value":"Medium Scroll/Wondrous"},{"row":1,"column":34,"value":"Minor Potion/Wondrous"},{"row":1,"column":35,"value":"Medium Potion/Wondrous"},{"row":1,"column":36,"value":"Minor Item"},{"row":1,"column":37,"value":"Medium Item"},{"row":1,"column":38,"value":"Major Item"},{"row":1,"column":39,"value":"Minor Ring/Wand/Wondrous"},{"row":1,"column":40,"value":"Minor Wondrous"},{"row":1,"column":41,"value":"Medium Wondrous"},{"row":1,"column":42,"value":"Major Wondrous"},{"row":1,"column":43,"value":"Minor Potion/Scroll/Wondrous"},{"row":1,"column":44,"value":"Medium Potion/Scroll/Wondrous"},{"row":1,"column":45,"value":"Minor Armor/Shield/Weapon"},{"row":1,"column":46,"value":"Medium Armor/Shield/Weapon"},{"row":2,"column":1,"value":"Academy"},{"row":2,"column":2,"value":"52"},{"row":2,"column":3,"value":"100"},{"row":2,"column":4,"value":"2"},{"row":2,"column":5,"value":"2"},{"row":2,"column":6,"value":"2"},{"row":2,"column":7,"value":"0"},{"row":2,"column":8,"value":"Err:509"},{"row":2,"column":9,"value":"Err:509"},{"row":2,"column":10,"value":"Err:509"},{"row":2,"column":11,"value":"0"},{"row":2,"column":12,"value":"Err:509"},{"row":2,"column":13,"value":"1"},{"row":2,"column":14,"value":"0"},{"row":2,"column":15,"value":"0"},{"row":2,"column":16,"value":"0"},{"row":2,"column":17,"value":"1"},{"row":2,"column":18,"value":"0"},{"row":2,"column":19,"value":"2"},{"row":2,"column":20,"value":"2"},{"row":2,"column":21,"value":"Caster’s Tower, Library, Magic Shop"},{"row":2,"column":22,"value":"Library"},{"row":2,"column":23,"value":"University"},{"row":2,"column":26,"value":"3 minor scrolls or wondrous items, 2 medium scrolls or wondrous items"},{"row":2,"column":27,"value":"An institution of higher learning."},{"row":2,"column":32,"value":"3"},{"row":2,"column":33,"value":"2"},{"row":3,"column":1,"value":"Aerie"},{"row":3,"column":2,"value":"18"},{"row":3,"column":3,"value":"10"},{"row":3,"column":4,"value":"1"},{"row":3,"column":5,"value":"0"},{"row":3,"column":6,"value":"0"},{"row":3,"column":7,"value":"2"},{"row":3,"column":8,"value":"Err:509"},{"row":3,"column":9,"value":"Err:509"},{"row":3,"column":10,"value":"Err:509"},{"row":3,"column":11,"value":"-1"},{"row":3,"column":12,"value":"Err:509"},{"row":3,"column":13,"value":"0"},{"row":3,"column":14,"value":"0"},{"row":3,"column":15,"value":"0"},{"row":3,"column":16,"value":"0"},{"row":3,"column":17,"value":"0"},{"row":3,"column":18,"value":"0"},{"row":3,"column":19,"value":"0"},{"row":3,"column":20,"value":"0"},{"row":3,"column":25,"value":"+2 bonus to Stability checks against Monster Attacks involving flying monsters."},{"row":3,"column":29,"value":"1"},{"row":4,"column":1,"value":"Alchemist"},{"row":4,"column":2,"value":"18"},{"row":4,"column":3,"value":"10"},{"row":4,"column":4,"value":"1"},{"row":4,"column":5,"value":"1"},{"row":4,"column":6,"value":"0"},{"row":4,"column":7,"value":"0"},{"row":4,"column":8,"value":"Err:509"},{"row":4,"column":9,"value":"Err:509"},{"row":4,"column":10,"value":"Err:509"},{"row":4,"column":11,"value":"0"},{"row":4,"column":12,"value":"Err:509"},{"row":4,"column":13,"value":"0"},{"row":4,"column":14,"value":"0"},{"row":4,"column":15,"value":"0"},{"row":4,"column":16,"value":"0"},{"row":4,"column":17,"value":"0"},{"row":4,"column":18,"value":"0"},{"row":4,"column":19,"value":"0"},{"row":4,"column":20,"value":"0"},{"row":4,"column":24,"value":"Adjacent to 1 House"},{"row":4,"column":25,"value":"Base Value +1,000 gp"},{"row":4,"column":26,"value":"1 minor potion or wondrous item"},{"row":4,"column":27,"value":"The laboratory and home of a crafter of poisons, potions, or alchemical items."},{"row":4,"column":30,"value":"1000"},{"row":4,"column":34,"value":"1"},{"row":5,"column":1,"value":"Animated Automation"},{"row":5,"column":2,"value":"5"},{"row":5,"column":3,"value":"0"},{"row":5,"column":4,"value":"0"},{"row":5,"column":5,"value":"1"},{"row":5,"column":6,"value":"-1"},{"row":5,"column":7,"value":"0"},{"row":5,"column":8,"value":"Err:509"},{"row":5,"column":9,"value":"Err:509"},{"row":5,"column":10,"value":"Err:509"},{"row":5,"column":11,"value":"0"},{"row":5,"column":12,"value":"Err:509"},{"row":5,"column":13,"value":"1"},{"row":5,"column":14,"value":"0"},{"row":5,"column":15,"value":"0"},{"row":5,"column":16,"value":"0"},{"row":5,"column":17,"value":"1"},{"row":5,"column":18,"value":"0"},{"row":5,"column":19,"value":"0"},{"row":5,"column":20,"value":"0"},{"r